---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations, type Language } from '~/i18n';
import { getCollection } from 'astro:content';

export const getStaticPaths = () => {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'mn' } },
  ];
};

const { lang } = Astro.params;
const currentLang = (lang as Language) || 'mn';
const t = useTranslations(currentLang);

const metadata = {
  title: t('changelog.title'),
  description: t('changelog.description'),
};

// Fetch all changelog entries for the current language
const allChangelog = await getCollection('changelog');
const changelogEntries = allChangelog
  .filter((entry) => entry.id.startsWith(`${currentLang}/`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Helper function to format date
function formatDate(date: Date, lang: string): string {
  if (lang === 'mn') {
    // YYYY-MM-DD format for Mongolian
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }
  // Long form for English (e.g., "December 5, 2025")
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// Group entries by date
const entriesByDate = new Map<string, typeof changelogEntries>();
changelogEntries.forEach(entry => {
  const dateKey = entry.data.date.toISOString().split('T')[0]; // YYYY-MM-DD
  if (!entriesByDate.has(dateKey)) {
    entriesByDate.set(dateKey, []);
  }
  entriesByDate.get(dateKey)!.push(entry);
});

// Group entries by action within each date
type ActionType = 'added' | 'updated' | 'removed';
const actionOrder: ActionType[] = ['added', 'updated', 'removed'];

function groupByAction(entries: typeof changelogEntries) {
  const grouped = new Map<ActionType, typeof changelogEntries>();

  entries.forEach(entry => {
    const action = entry.data.action as ActionType;
    if (!grouped.has(action)) {
      grouped.set(action, []);
    }
    grouped.get(action)!.push(entry);
  });

  return grouped;
}
---

<Layout metadata={metadata}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight dark:text-white mb-2">{t('changelog.title')}</h1>
      <p class="text-base text-muted dark:text-slate-400">{t('changelog.description')}</p>
    </header>

    {changelogEntries.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-muted dark:text-slate-400">{t('changelog.noChanges')}</p>
      </div>
    ) : (
      <div class="space-y-8">
        {Array.from(entriesByDate.entries()).map(([dateKey, entries]) => {
          const firstEntry = entries[0];
          const formattedDate = formatDate(firstEntry.data.date, currentLang);
          const groupedByAction = groupByAction(entries);

          return (
            <div class="grid grid-cols-1 md:grid-cols-[200px_1fr] gap-4 md:gap-8">
              <!-- Date column (left) -->
              <div class="md:text-right">
                <time
                  class="text-sm font-medium text-gray-700 dark:text-gray-300 md:sticky md:top-24"
                  datetime={dateKey}
                >
                  {formattedDate}
                </time>
              </div>

              <!-- Entries column (right) -->
              <div class="space-y-4">
                {actionOrder.map((action) => {
                  const actionEntries = groupedByAction.get(action);
                  if (!actionEntries || actionEntries.length === 0) return null;

                  const actionLabel = t(`changelog.action.${action}`);

                  return (
                    <div class="space-y-2">
                      <!-- Action subheading -->
                      <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
                        {actionLabel}
                      </h3>

                      <!-- Entries for this action -->
                      {actionEntries.map((entry) => {
                        const { dataset_id, dataset_name_en, dataset_name_mn, description_en, description_mn } = entry.data;
                        const datasetName = currentLang === 'en' ? dataset_name_en : dataset_name_mn;
                        const description = currentLang === 'en' ? description_en : description_mn;

                        return (
                          <div class="flex gap-3 text-sm">
                            <!-- Bullet point -->
                            <span class="text-gray-400 dark:text-gray-600 mt-1 select-none">•</span>

                            <!-- Content -->
                            <div class="flex-1 leading-relaxed">
                              <a
                                href={`/${currentLang}/data/${dataset_id}`}
                                class="text-gray-900 dark:text-white hover:text-primary dark:hover:text-primary transition-colors font-medium"
                              >
                                {datasetName}
                              </a>
                              {description && (
                                <>
                                  {' — '}
                                  <span class="text-gray-600 dark:text-gray-400">
                                    {description}
                                  </span>
                                </>
                              )}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</Layout>
