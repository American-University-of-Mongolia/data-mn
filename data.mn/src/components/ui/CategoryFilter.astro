---
/**
 * CategoryFilter - Client-side category filter pills
 *
 * Displays category pills and filters content when clicked.
 * Works with any grid that has data-category attributes on items.
 */

interface Props {
  categories: string[];
  allLabel?: string;
  class?: string;
}

const { categories, allLabel = 'All', class: className = '' } = Astro.props;

// Remove duplicates and sort
const uniqueCategories = [...new Set(categories)].filter(Boolean).sort();
---

<div class:list={['category-filter flex flex-wrap gap-2 mb-8', className]}>
  <button
    type="button"
    class="filter-btn active px-4 py-2 text-sm font-medium rounded-full bg-primary text-white transition-colors"
    data-category="all"
  >
    {allLabel}
  </button>
  {uniqueCategories.map((category) => (
    <button
      type="button"
      class="filter-btn px-4 py-2 text-sm font-medium rounded-full bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 hover:bg-primary hover:text-white dark:hover:bg-primary transition-colors"
      data-category={category}
    >
      {category}
    </button>
  ))}
</div>

<script>
  function initCategoryFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const gridItems = document.querySelectorAll('[data-category]');

    if (!filterBtns.length) return;

    // Function to activate a category filter
    function activateCategory(category: string) {
      // Update active state
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-primary', 'text-white');
        b.classList.add('bg-gray-100', 'dark:bg-slate-800', 'text-gray-700', 'dark:text-gray-300');
      });

      // Find and activate the button
      const targetBtn = Array.from(filterBtns).find(
        (btn) => btn.getAttribute('data-category') === category
      );

      if (targetBtn) {
        targetBtn.classList.add('active', 'bg-primary', 'text-white');
        targetBtn.classList.remove('bg-gray-100', 'dark:bg-slate-800', 'text-gray-700', 'dark:text-gray-300');
      }

      // Filter items
      gridItems.forEach((item) => {
        if (item.classList.contains('filter-btn')) return; // Skip filter buttons

        const el = item as HTMLElement;
        const itemCategory = el.getAttribute('data-category');
        if (category === 'all' || itemCategory === category) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    }

    // Add click handlers
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');
        if (category) {
          activateCategory(category);
        }
      });
    });

    // Check for category URL parameter on page load
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('category');

    if (categoryParam) {
      // Pre-select the category from URL parameter
      activateCategory(categoryParam);
    }
  }

  // Run on initial load
  initCategoryFilter();

  // Re-run when navigating with View Transitions
  document.addEventListener('astro:page-load', initCategoryFilter);
</script>
