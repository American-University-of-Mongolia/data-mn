{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын мах үйлдвэрлэл бүсээр 2010-2024",
  "data": {
    "url": "/datasets/meat-production-by-region-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "он",
      "type": "quantitative",
      "title": "Он",
      "axis": {
        "format": "d",
        "tickMinStep": 1,
        "grid": false
      }
    },
    "y": {
      "field": "үйлдвэрлэл_тонн",
      "type": "quantitative",
      "title": "Тонн",
      "axis": {
        "format": ",.0f"
      }
    },
    "color": {
      "field": "бүс",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Баруун бүс",
          "Хангайн бүс",
          "Төвийн бүс",
          "Зүүн бүс",
          "Улаанбаатар"
        ],
        "range": [
          "#4c78a8",
          "#f58518",
          "#e45756",
          "#72b7b2",
          "#54a24b"
        ]
      },
      "legend": {
        "orient": "top"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "он",
            "title": "Он",
            "format": "d"
          },
          {
            "field": "бүс",
            "title": "Бүс"
          },
          {
            "field": "үйлдвэрлэл_тонн",
            "title": "Үйлдвэрлэл (тонн)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}