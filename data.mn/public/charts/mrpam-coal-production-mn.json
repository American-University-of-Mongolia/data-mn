{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын нүүрсний олборлолт, борлуулалт, экспорт, мянган тонн (2021–2025)",
  "data": {
    "url": "/datasets/mrpam-coal-production-mn.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "datum['он'] + '-' + (datum['сар'] < 10 ? '0' + datum['сар'] : '' + datum['сар']) + '-01'",
      "as": "date"
    },
    {
      "fold": ["олборлолт_мян_тн", "борлуулалт_мян_тн", "экспорт_мян_тн"],
      "as": ["metric", "value"]
    },
    {
      "calculate": "datum.metric === 'олборлолт_мян_тн' ? 'Олборлолт' : datum.metric === 'борлуулалт_мян_тн' ? 'Борлуулалт' : 'Экспорт'",
      "as": "metric_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Огноо",
      "axis": {"format": "%b %Y", "labelAngle": -45, "grid": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Мянган тонн",
      "scale": {"zero": true},
      "axis": {"format": ",.0f", "grid": true, "gridOpacity": 0.3}
    },
    "color": {
      "field": "metric_label",
      "type": "nominal",
      "title": "Үзүүлэлт",
      "scale": {
        "domain": ["Олборлолт", "Борлуулалт", "Экспорт"],
        "range": ["#4c78a8", "#f58518", "#e45756"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"}
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 60},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Огноо", "format": "%b %Y"},
          {"field": "metric_label", "type": "nominal", "title": "Үзүүлэлт"},
          {"field": "value", "type": "quantitative", "title": "Мянган тонн", "format": ",.1f"}
        ]
      }
    }
  ],
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
