{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia Real Wage Index (1992–2025). Index: 2023 = 100. Dashed lines mark a source change in 2014 and a methodology change in 2025. Comparability across 2014 has not been confirmed; NSO explicitly states that 2025 (orange point) is not comparable with earlier years.",
  "data": {
    "url": "/datasets/real-wage-index-national-en.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "title": "Year",
      "scale": {
        "domain": [1992, 2026],
        "nice": false
      },
      "axis": {
        "format": "d",
        "tickCount": 6,
        "grid": false,
        "labelAngle": 0,
        "labelOverlap": "greedy",
        "labelSeparation": 8
      }
    },
    "y": {
      "field": "Real wage index (2023=100)",
      "type": "quantitative",
      "title": "Index (2023=100)",
      "scale": {
        "zero": true,
        "domainMax": 140
      },
      "axis": {
        "format": ".0f",
        "gridOpacity": 0.25
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum['Year'] < 2014"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "color": "#1f77b4",
        "interpolate": "linear"
      },
      "encoding": {
