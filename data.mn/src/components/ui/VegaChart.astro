---
import ChartControls from './ChartControls.astro';
/**
 * VegaChart Component
 *
 * Embeds responsive Vega-Lite visualizations in content pages.
 * Charts automatically resize to fit their container.
 *
 * Usage:
 * <VegaChart spec="/charts/my-chart.json" title="Chart Title" />
 */

export interface Props {
  spec: string | object;
  title?: string;
  caption?: string;
  aspectRatio?: number; // height/width ratio, default 0.5 (2:1)
  interactive?: boolean;
  prominentControls?: boolean;
  yearGroup?: string; // Share selectedYear with charts in the same group.
}

const {
  spec,
  title,
  caption,
  aspectRatio = 0.5,
  interactive = false,
  prominentControls = false,
  yearGroup,
} = Astro.props;
const chartId = `chart-${Math.random().toString(36).substring(2, 11)}`;
const isInlineSpec = typeof spec === 'object';
---

<div class="vega-chart-container my-4 not-prose" data-prominent-controls={prominentControls || undefined}>
  {
    title &&
      // Keep the title and the year span adjacent: a line break between them renders as a space.
      // prettier-ignore
      <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-gray-100">{title}{yearGroup && <span data-selected-year class="ml-2 tabular-nums text-gray-500 dark:text-gray-400" />}</h3>
  }
  <ChartControls enabled={interactive}>
    <!-- prettier-ignore -->
    <div
      id={chartId}
      class="vega-chart w-full"
      data-spec={isInlineSpec ? JSON.stringify(spec) : spec}
      data-is-inline={isInlineSpec}
      data-aspect-ratio={aspectRatio}
      data-interactive={interactive}
      data-prominent-controls={prominentControls}
      data-year-group={yearGroup}
    ></div>
  </ChartControls>

  {caption && <p class="text-sm text-gray-600 dark:text-gray-400 mt-2 italic">{caption}</p>}
</div>

<script is:inline>
  (function () {
    // Prevent multiple initializations
    if (window._vegaChartInitialized) return;
    window._vegaChartInitialized = true;

    // Store chart views for resize handling
    let chartViews = {};
    let chartFinalizers = {};
    let linkedYears = {};
    let resizeTimeout = null;
    let pageGeneration = 0;
    const decimalNumberFormat = ',.6~f';
    const legendLayoutTools = import('/scripts/chart-legend-layout.js');
    const chartThemeTools = import('/scripts/chart-theme.js');

    // Vega treats a bare "," as a general-number format and can render
    // thousands as 1e+4. Normalize legacy and explicitly exponential formats
    // before embedding so axes and tooltips always use ordinary decimals.
    function normalizeNumberFormats(value) {
      if (Array.isArray(value)) {
        value.forEach(normalizeNumberFormats);
      } else if (value && typeof value === 'object') {
        Object.keys(value).forEach(function (key) {
          const child = value[key];
          if (
            key === 'format' &&
            typeof child === 'string' &&
            (child === ',' || (child.indexOf('%') === -1 && /e$/i.test(child)))
          ) {
            value[key] = decimalNumberFormat;
          } else {
            normalizeNumberFormats(child);
          }
        });
      }
      return value;
    }

    function hasBarMark(spec) {
      const mark = spec.mark && (spec.mark.type || spec.mark);
      if (mark === 'bar') return true;
      return (spec.layer || []).some(hasBarMark);
    }

    // A single-view bar chart whose y axis lists categories (e.g. sectors).
    function isCategoryBarChart(spec) {
      const y = spec.encoding && spec.encoding.y;
      return (
        !!y &&
        (y.type === 'nominal' || y.type === 'ordinal') &&
        !spec.facet &&
        !spec.encoding.row &&
        !spec.concat &&
        !spec.hconcat &&
        !spec.vconcat &&
        hasBarMark(spec)
      );
    }

    // Vega expression splitting a label at the last space before `n`
    // characters; the second line is ellipsized by labelLimit if still long.
    function wrapLabelExpr(n) {
      const cut = 'lastindexof(substring(datum.label, 0, ' + n + "), ' ')";
      return (
        'length(datum.label) <= ' +
        n +
        ' || ' +
        cut +
        ' < 1 ? datum.label : ' +
        '[substring(datum.label, 0, ' +
        cut +
        '), substring(datum.label, ' +
        cut +
        ' + 1)]'
      );
    }

    async function loadFieldValues(spec, field) {
      try {
        let rows = spec.data && spec.data.values;
        if (!rows && spec.data && spec.data.url) {
          rows = window.vega.read(await window.vega.loader().load(spec.data.url), {
            type: (spec.data.format && spec.data.format.type) || 'csv',
          });
        }
        return Array.from(
          new Set(
            (rows || []).map(function (row) {
              return String(row[field]);
            })
          )
        );
      } catch (error) {
        console.warn('Could not inspect chart labels:', error);
        return [];
      }
    }

    async function loadCategoricalLegendLabels(spec, tools) {
      const labels = tools.categoricalLegendLabels(spec);
      if (labels.length || !spec.data || !spec.data.url) return labels;

      try {
        const text = await window.vega.loader().load(spec.data.url);
        const rows = window.vega.read(text, {
          type: (spec.data.format && spec.data.format.type) || 'csv',
          parse: 'auto',
        });
        return tools.categoricalLegendLabels(spec, rows);
      } catch (error) {
        console.warn('Could not inspect chart legend labels:', error);
        return labels;
      }
    }

    // Load Vega libraries dynamically (only once)
    function loadVegaLibraries() {
      return new Promise(function (resolve, reject) {
        if (window.vegaEmbed) {
          resolve();
          return;
        }

        const scripts = [
          'https://cdn.jsdelivr.net/npm/vega@5.30.0',
          'https://cdn.jsdelivr.net/npm/vega-lite@5.21.0',
          'https://cdn.jsdelivr.net/npm/vega-embed@6.26.0',
        ];

        function loadScript(index) {
          if (index >= scripts.length) {
            resolve();
            return;
          }

          // Check if already loaded
          if (index === 0 && window.vega) {
            loadScript(1);
            return;
          }
          if (index === 1 && window.vegaLite) {
            loadScript(2);
            return;
          }
          if (index === 2 && window.vegaEmbed) {
            resolve();
            return;
          }

          const script = document.createElement('script');
          script.src = scripts[index];
          script.onload = function () {
            loadScript(index + 1);
          };
          script.onerror = function () {
            reject(new Error('Failed to load ' + scripts[index]));
          };
          document.head.appendChild(script);
        }

        loadScript(0);
      });
    }

    // The spec declares fields and default parameter values; controls retain
    // their state on the element when the chart is rebuilt after a resize.
    async function prepareExplorer(el, spec) {
      const config = spec.usermeta && spec.usermeta.explorer;
      if (el.dataset.interactive !== 'true' || !config) return null;
      const controls = el.closest('.chart-controls');
      const hasYears = !!config.yearField;
      const rows = window.vega.read(await window.vega.loader().load(spec.data.url), { type: 'csv', parse: 'auto' });
      spec.data = { values: rows };
      const years = hasYears
        ? Array.from(
            new Set(
              rows.map(function (row) {
                return +row[config.yearField];
              })
            )
          ).sort(function (a, b) {
            return a - b;
          })
        : [];
      const categories = Array.from(
        new Set(
          rows.map(function (row) {
            return row[config.categoryField];
          })
        )
      ).sort();
      const defaults = {};
      spec.params.forEach(function (param) {
        defaults[param.name] = param.value;
      });
      const state =
        el._explorerState ||
        Object.assign(
          {
            selectedCategories: defaults.selectedCategories.slice(),
            pending: Promise.resolve(),
          },
          hasYears ? { yearStart: defaults.yearStart, yearEnd: defaults.yearEnd } : {}
        );
      el._explorerState = state;
      spec.params.forEach(function (param) {
        param.value = state[param.name];
      });
      const start = controls.querySelector('[data-year-start]');
      const end = controls.querySelector('[data-year-end]');
      const options = controls.querySelector('.category-options');
      const picker = controls.querySelector('details');
      controls.querySelector('[data-category-title]').textContent = spec.encoding.color.title;
      options.replaceChildren();
      categories.forEach(function (category) {
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.value = category;
        const swatch = document.createElement('span');
        swatch.className = 'color-swatch';
        const scale = spec.encoding.color.scale;
        swatch.style.backgroundColor = scale.range[scale.domain.indexOf(category)];
        label.append(input, swatch, document.createTextNode(category));
        options.append(label);
      });
      if (hasYears) {
        [start, end].forEach(function (select) {
          select.replaceChildren();
          years.forEach(function (year) {
            select.add(new Option(String(year), String(year)));
          });
        });
      } else {
        controls.querySelector('[data-controls-section]').classList.add('no-years');
      }
      function decorateLegend() {
        el.querySelectorAll('.role-legend-label text').forEach(function (label, index) {
          const category = state.selectedCategories[index];
          label.setAttribute('tabindex', '0');
          label.setAttribute('role', 'button');
          label.setAttribute('aria-pressed', 'true');
          label.setAttribute('aria-label', category);
          label.style.cursor = 'pointer';
          label.style.pointerEvents = 'all';
          label.onclick = function () {
            hideCategory(category);
          };
          const symbol = label.parentElement.parentElement.querySelector('.role-legend-symbol path');
          if (symbol) {
            symbol.style.pointerEvents = 'all';
            symbol.style.cursor = 'pointer';
            symbol.onclick = label.onclick;
          }
          label.onkeydown = function (event) {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              hideCategory(category);
            }
          };
        });
      }
      function syncControls() {
        if (hasYears) {
          start.value = String(state.yearStart);
          end.value = String(state.yearEnd);
          Array.from(start.options).forEach(function (option) {
            option.disabled = +option.value > state.yearEnd;
          });
          Array.from(end.options).forEach(function (option) {
            option.disabled = +option.value < state.yearStart;
          });
        }
        options.querySelectorAll('input').forEach(function (input) {
          input.checked = state.selectedCategories.includes(input.value);
        });
        controls.querySelector('[data-selection-count]').textContent =
          state.selectedCategories.length + ' / ' + categories.length;
        controls.querySelector('.chart-empty').hidden = state.selectedCategories.length !== 0;
      }
      function update() {
        syncControls();
        state.pending = state.pending
          .then(async function () {
            const view = chartViews[el.id];
            if (!view) return;
            let sig = view.signal('selectedCategories', state.selectedCategories.slice());
            if (hasYears) sig = sig.signal('yearStart', state.yearStart).signal('yearEnd', state.yearEnd);
            await sig.resize().runAsync();
            decorateLegend();
          })
          .catch(function (error) {
            console.error('Error updating chart filters:', error);
          });
      }
      function hideCategory(category) {
        state.selectedCategories = state.selectedCategories.filter(function (value) {
          return value !== category;
        });
        update();
      }
      controls.onchange = function (event) {
        if (hasYears && event.target === start) state.yearStart = +start.value;
        else if (hasYears && event.target === end) state.yearEnd = +end.value;
        else if (event.target.type === 'checkbox') {
          state.selectedCategories = categories.filter(function (category) {
            return category === event.target.value ? event.target.checked : state.selectedCategories.includes(category);
          });
        }
        update();
      };
      controls.onclick = function (event) {
        const button = event.target.closest('button');
        if (!button) return;
        if (button.hasAttribute('data-select-all')) state.selectedCategories = categories.slice();
        if (button.hasAttribute('data-clear')) state.selectedCategories = [];
        if (button.hasAttribute('data-reset')) {
          state.selectedCategories = defaults.selectedCategories.slice();
          if (hasYears) {
            state.yearStart = defaults.yearStart;
            state.yearEnd = defaults.yearEnd;
          }
        }
        update();
      };
      const search = controls.querySelector('[data-category-search]');
      const specLabels = config.labels || {};
      if (specLabels.search) {
        search.placeholder = specLabels.search;
        search.setAttribute('aria-label', specLabels.search);
      }
      if (specLabels.noMatches) controls.querySelector('[data-no-matches]').textContent = specLabels.noMatches;
      if (specLabels.empty) controls.querySelector('.chart-empty').textContent = specLabels.empty;
      function filterOptions() {
        const query = search.value.toLocaleLowerCase().trim();
        let matches = 0;
        options.querySelectorAll('label').forEach(function (label) {
          label.hidden = !label.textContent.toLocaleLowerCase().includes(query);
          if (!label.hidden) matches++;
        });
        controls.querySelector('[data-no-matches]').hidden = matches !== 0;
      }
      search.oninput = filterOptions;
      filterOptions();
      picker.ontoggle = function () {
        if (picker.open) picker.querySelector('.category-panel').scrollIntoView({ block: 'nearest' });
      };
      controls.onkeydown = function (event) {
        if (event.key === 'Escape' && picker.open) {
          picker.open = false;
          picker.querySelector('summary').focus();
        }
      };
      syncControls();
      controls.querySelectorAll('[data-controls-section]').forEach(function (section) {
        section.hidden = false;
      });
      return decorateLegend;
    }

    // Keep bound dropdown/slider values across theme changes and resizing.
    // Hover selections are transient and should not be restored.
    function prepareBoundParameters(el, spec) {
      const params = (spec.params || []).filter(function (param) {
        return param.bind && !param.select && Object.hasOwn(param, 'value');
      });
      // Legend-bound selections use Vega data stores, not scalar signals.
      el._selectionStores = (spec.params || [])
        .filter(function (param) {
          return param.bind && param.select;
        })
        .map(function (param) {
          return param.name + '_store';
        });
      params.forEach(function (param) {
        if (el._bindingValues && Object.hasOwn(el._bindingValues, param.name)) {
          param.value = el._bindingValues[param.name];
        }
      });
      return async function (view) {
        if (el._selectionState) {
          view.setState(el._selectionState);
          await view.runAsync();
        }
        params.forEach(function (param) {
          view.addSignalListener(param.name, function (name, value) {
            el._bindingValues = Object.assign({}, el._bindingValues, { [name]: value });
          });
        });
      };
    }

    // Opt-in year linking. State survives responsive re-embedding, and a
    // chart finishing its initial load later receives the current selection.
    function prepareLinkedYear(el, spec) {
      const group = el.dataset.yearGroup;
      if (!group) return null;
      const param = (spec.params || []).find(function (item) {
        return item.name === 'selectedYear';
      });
      if (!param) return null;
      let state = linkedYears[group];
      if (!state) state = linkedYears[group] = { value: param.value, pending: Promise.resolve() };
      param.value = state.value;

      function sync() {
        state.pending = state.pending
          .then(async function () {
            for (const id of Object.keys(chartViews)) {
              const peer = document.getElementById(id);
              const peerView = chartViews[id];
              if (!peer || peer.dataset.yearGroup !== group || !peerView) continue;
              if (id !== state.controllerId && peerView.signal('selectedYear') !== state.value) {
                await peerView.signal('selectedYear', state.value).runAsync();
              }
              const label = peer.closest('.vega-chart-container').querySelector('[data-selected-year]');
              if (label) label.textContent = String(peerView.signal('selectedYear'));
            }
          })
          .catch(function (error) {
            console.error('Error updating linked chart year:', error);
          });
        return state.pending;
      }

      return async function (view) {
        // The bound slider owns the year. Never write back to that view while
        // its input is changing; a queued older update could erase a new one.
        if (param.bind) {
          state.controllerId = el.id;
          if (view.signal('selectedYear') !== state.value) {
            await view.signal('selectedYear', state.value).runAsync();
          }
          view.addSignalListener('selectedYear', function (name, value) {
            if (state.value === value) return;
            state.value = value;
            sync();
          });
        }
        return sync();
      };
    }

    function invalidateChart(el) {
      // Never embed twice into the same element. A change during loading
      // is replayed after that render finishes, using the latest theme.
      if (el.dataset.rendering === 'true') {
        el._refreshAfterRender = true;
        return;
      }
      if (chartViews[el.id]) {
        if (el._selectionStores?.length) {
          el._selectionState = chartViews[el.id].getState({
            signals: function () {
              return false;
            },
            data: function (name) {
              return el._selectionStores.includes(name);
            },
            recurse: false,
          });
        }
        chartFinalizers[el.id]();
        delete chartViews[el.id];
        delete chartFinalizers[el.id];
      }
      el.removeAttribute('data-rendered');
    }

    function refreshCharts() {
      document.querySelectorAll('.vega-chart[data-spec]').forEach(invalidateChart);
      initVegaCharts();
    }

    // Debounced resize handler
    function handleResize() {
      if (resizeTimeout) clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(refreshCharts, 250);
    }

    // Initialize all Vega charts on the page
    async function initVegaCharts() {
      const generation = pageGeneration;
      const charts = document.querySelectorAll('.vega-chart[data-spec]');
      if (charts.length === 0) return;

      // Ensure libraries are loaded
      try {
        await loadVegaLibraries();
      } catch (error) {
        console.error('Failed to load Vega libraries:', error);
        return;
      }
      const legendTools = await legendLayoutTools;
      const themeTools = await chartThemeTools;
      if (generation !== pageGeneration) return;

      charts.forEach(async function (el) {
        const chartId = el.id;

        // Skip if already rendered
        if (!el.isConnected || el.getAttribute('data-rendered') === 'true' || el.dataset.rendering === 'true') return;

        const isInline = el.dataset.isInline === 'true';
        const specData = el.dataset.spec;
        const aspectRatio = parseFloat(el.dataset.aspectRatio) || 0.5;

        // Measure container width
        const containerWidth = el.offsetWidth;
        if (containerWidth < 100) {
          setTimeout(function () {
            initVegaCharts();
          }, 100);
          return;
        }

        const minimumHeight = containerWidth < 480 ? 400 : 250;
        const calculatedHeight = Math.min(Math.max(containerWidth * aspectRatio, minimumHeight), 500);

        el.dataset.rendering = 'true';
        try {
          let chartSpec;

          if (isInline) {
            chartSpec = JSON.parse(specData);
          } else {
            const response = await fetch(specData);
            if (!response.ok) {
              throw new Error('Failed to load chart spec: ' + response.statusText);
            }
            chartSpec = await response.json();
          }

          if (generation !== pageGeneration || !el.isConnected) return;
          // Rebuild opt-in comparison charts with the selected value. Vega's
          // legend facets can retain the previous labels' widths after a swap.
          // Keeping this state also preserves the choice across screen resizes.
          const prominentControls = el.dataset.prominentControls === 'true';
          if (prominentControls) {
            if (!el._comparisonChangeBound) {
              el.addEventListener('change', function (event) {
                const control = event.target;
                if (!(control instanceof HTMLSelectElement)) return;
                el._bindingValues = Object.assign({}, el._bindingValues, { [control.name]: control.value });
                invalidateChart(el);
                el._restoreComparisonFocus = true;
                initVegaCharts();
              });
              el._comparisonChangeBound = true;
            }
          }

          const attachBindings = prepareBoundParameters(el, chartSpec);
          const attachExplorer = await prepareExplorer(el, chartSpec);
          if (generation !== pageGeneration || !el.isConnected) return;
          const attachLinkedYear = prepareLinkedYear(el, chartSpec);
          normalizeNumberFormats(chartSpec);
          const legendLabels = await loadCategoricalLegendLabels(chartSpec, legendTools);
          const legendLayout = legendTools.applyCategoricalLegendLayout(
            chartSpec,
            legendLabels,
            containerWidth,
            attachExplorer ? 14 : 13
          );
          // Asymmetric padding: more on left/bottom for axes, minimal on right/top
          // Use category10 color scheme (D3 default) - brighter than tableau10
          const existingConfig = chartSpec.config || {};
          chartSpec = Object.assign({}, chartSpec, {
            width: containerWidth,
            height: calculatedHeight,
            padding: { left: 5, right: 5, top: 5, bottom: 0 },
            autosize: { type: 'fit', contains: 'padding' },
            config: Object.assign({}, existingConfig, {
              // Never let Vega's default general formatter switch large or
              // small quantitative values to scientific notation.
              numberFormat: decimalNumberFormat,
              legend: Object.assign({}, existingConfig.legend || {}, {
                columns: legendLayout.columns,
                labelLimit: legendLayout.labelLimit,
              }),
              range: Object.assign({}, existingConfig.range || {}, {
                category: { scheme: 'category10' },
              }),
            }),
          });

          if (!attachExplorer && isCategoryBarChart(chartSpec)) {
            // Horizontal bars with long category names: give each row a fixed
            // height instead of squeezing every row into the default chart
            // height, and wrap names onto two lines within a width that leaves
            // the plot at least ~55% of the container, even on phones.
            const labelWidth = Math.round(Math.min(300, Math.max(120, containerWidth * 0.4)));
            const wrapChars = Math.max(14, Math.floor(labelWidth / 7.5));
            const yAxis = chartSpec.encoding.y.axis || {};
            const yLabels = await loadFieldValues(chartSpec, chartSpec.encoding.y.field);
            const wraps = yLabels.some(function (label) {
              return label.length > wrapChars;
            });
            chartSpec.encoding.y.axis = Object.assign(
              wraps
                ? {
                    labelExpr: wrapLabelExpr(wrapChars),
                    labelLineHeight: 15,
                  }
                : {},
              yAxis,
              { labelLimit: Math.min(yAxis.labelLimit || labelWidth, labelWidth) }
            );
            chartSpec.height = { step: wraps ? 34 : 24 };
            chartSpec.autosize = { type: 'fit-x', contains: 'padding' };
          }

          if (attachExplorer) {
            // Fit the available width while allowing axes and the legend to
            // add height. Recompute layout whenever the selection changes.
            chartSpec.autosize = { type: 'fit-x', contains: 'padding', resize: true };
            chartSpec.height = containerWidth < 480 ? 320 : Math.min(Math.max(containerWidth * 0.5, 380), 520);
            if (window.innerWidth >= 1024) {
              await document.fonts.ready;
              const chartTop = el.getBoundingClientRect().top + window.scrollY;
              const availableHeight = Math.floor(window.innerHeight - chartTop - 20);
              // Leave room for the filter toolbar below so chart and controls
              // fit the first desktop viewport together.
              const chartHeight = availableHeight - 90;
              if (chartHeight >= 300) {
                // Reserve space for the entire chart, including legend and
                // axes, in the first desktop viewport. Controls follow below.
                chartSpec.autosize = { type: 'fit', contains: 'padding', resize: true };
                chartSpec.height = Math.min(600, chartHeight);
              }
            }
            const colorLegend = chartSpec.encoding.color.legend;
            if (colorLegend !== null && colorLegend !== false) {
              chartSpec.encoding.color.legend = Object.assign({}, colorLegend, {
                orient: 'top',
                columns: legendLayout.columns,
                labelLimit: legendLayout.labelLimit,
                rowPadding: 10,
                columnPadding: 18,
                labelFontSize: 14,
                offset: 20,
              });
            }
            if (chartSpec.encoding.x.type !== 'nominal' && chartSpec.encoding.x.type !== 'ordinal') {
              chartSpec.encoding.x.axis = Object.assign({}, chartSpec.encoding.x.axis, {
                tickCount: Math.max(3, Math.floor(containerWidth / 90)),
              });
            }
            if (containerWidth < 480) {
              chartSpec.config.axis = Object.assign({}, chartSpec.config.axis, {
                labelFontSize: 12,
                titleFontSize: 14,
              });
              // Long category labels squeeze the plot and clip centered axis
              // titles on narrow screens; cap the y-axis label width so the
              // plot keeps room. Harmless for quantitative y-axes (short labels).
              const yAxis = (chartSpec.encoding.y && chartSpec.encoding.y.axis) || {};
              chartSpec.encoding.y = Object.assign({}, chartSpec.encoding.y, {
                axis: Object.assign({}, yAxis, { labelLimit: Math.min(yAxis.labelLimit || 250, 150) }),
              });
            }
          }

          // The spec is freshly loaded each time, so light mode restores its
          // original styling. Apply dark colors after all layout overrides.
          const dark = document.documentElement.classList.contains('dark');
          themeTools.applyChartTheme(chartSpec, dark);
          const options = {
            actions: {
              export: { png: true, svg: true },
              source: false,
              editor: false,
            },
            theme: dark ? 'dark' : 'vox',
            renderer: 'svg',
            // 4x resolution for PNG exports (default scaleFactor 1 looks blurry)
            scaleFactor: 4,
          };

          if (generation !== pageGeneration || !el.isConnected) return;
          const result = await window.vegaEmbed(el, chartSpec, options);
          if (generation !== pageGeneration || !el.isConnected) {
            result.finalize();
            return;
          }
          chartViews[chartId] = result.view;
          // Embed also owns the export menu's document listener.
          chartFinalizers[chartId] = result.finalize;
          await attachBindings(result.view);
          if (attachLinkedYear) await attachLinkedYear(result.view);
          if (attachExplorer) attachExplorer(result.view);
          el.setAttribute('data-rendered', 'true');
          if (el._restoreComparisonFocus) {
            el.querySelector('select')?.focus({ preventScroll: true });
            delete el._restoreComparisonFocus;
          }
        } catch (error) {
          if (generation !== pageGeneration || !el.isConnected) return;
          console.error('Error rendering Vega chart:', error);
          el.innerHTML = '<div class="text-red-600 p-4">Error loading chart: ' + error.message + '</div>';
        } finally {
          delete el.dataset.rendering;
          if (el._refreshAfterRender && generation === pageGeneration && el.isConnected) {
            delete el._refreshAfterRender;
            invalidateChart(el);
            initVegaCharts();
          }
        }
      });
    }

    // One delegated handler also covers charts reached through Astro navigation.
    function dismissOutsidePicker(event) {
      document.querySelectorAll('.vega-chart-container .category-picker[open]').forEach(function (picker) {
        if (!picker.contains(event.target)) picker.open = false;
      });
    }
    document.addEventListener('pointerdown', dismissOutsidePicker);
    document.addEventListener('focusin', dismissOutsidePicker);

    // Set up resize listener (only once)
    if (!window._vegaResizeListenerAdded) {
      window.addEventListener('resize', handleResize);
      window._vegaResizeListenerAdded = true;
    }

    // The theme button changes the root class. Observe that shared state so
    // every chart updates, without coupling this component to the button.
    let darkMode = document.documentElement.classList.contains('dark');
    new MutationObserver(function () {
      const nextDarkMode = document.documentElement.classList.contains('dark');
      if (nextDarkMode === darkMode) return;
      darkMode = nextDarkMode;
      refreshCharts();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // Run on initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVegaCharts);
    } else {
      initVegaCharts();
    }

    // Dispose the outgoing page before the new charts initialize. In-flight
    // renders also check this generation before registering their views.
    document.addEventListener('astro:before-swap', function () {
      pageGeneration++;
      clearTimeout(resizeTimeout);
      Object.keys(chartViews).forEach(function (id) {
        chartFinalizers[id]();
      });
      chartViews = {};
      chartFinalizers = {};
      linkedYears = {};
    });
    document.addEventListener('astro:page-load', initVegaCharts);

    window.initVegaCharts = initVegaCharts;
  })();
</script>

