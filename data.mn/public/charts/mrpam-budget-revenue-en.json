{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "MRPAM budget revenue: plan vs actual for total mining revenue (2021–2025)",
  "data": {
    "url": "/datasets/mrpam-budget-revenue-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"filter": "datum.revenue_type === 'Total'"},
    {
      "calculate": "datum.year + '-' + (datum.month < 10 ? '0' + datum.month : '' + datum.month) + '-01'",
      "as": "date"
    },
    {
      "fold": ["plan_mln_mnt", "actual_mln_mnt"],
      "as": ["metric", "value"]
    },
    {
      "calculate": "datum.metric === 'plan_mln_mnt' ? 'Plan' : 'Actual'",
      "as": "metric_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Date",
      "axis": {"format": "%b %Y", "labelAngle": -45, "grid": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Million MNT",
      "scale": {"zero": true},
      "axis": {"format": ",.0f", "grid": true, "gridOpacity": 0.3}
    },
    "xOffset": {"field": "metric_label"},
    "color": {
      "field": "metric_label",
      "type": "nominal",
      "title": "Type",
      "scale": {
        "domain": ["Plan", "Actual"],
        "range": ["#94a3b8", "#4c78a8"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "mark": {"type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3},
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
