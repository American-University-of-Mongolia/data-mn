{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia Current Account Balance (2009-2026). Monthly data showing surpluses (positive) and deficits (negative) in million USD.",
  "data": {
    "url": "/datasets/bop-current-account-en.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.value >= 0",
      "as": "isPositive"
    }
  ],
  "encoding": {
    "x": {
      "field": "month",
      "type": "temporal",
      "title": "Month",
      "axis": {
        "format": "%Y",
        "tickCount": 8,
        "grid": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Million USD",
      "axis": {
        "format": ".0f"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "strokeWidth": 2,
          "stroke": "#1f77b4"
        },
        "interpolate": "monotone",
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {
              "offset": 0,
              "color": "rgba(31, 119, 180, 0.02)"
            },
            {
              "offset": 1,
              "color": "rgba(31, 119, 180, 0.35)"
            }
          ]
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "month",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Balance (Million USD)",
            "format": ",.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
