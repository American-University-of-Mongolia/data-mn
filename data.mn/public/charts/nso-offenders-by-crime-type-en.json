{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Offenders of crimes in Mongolia by crime type 2010–2024",
  "data": {
    "url": "/datasets/nso-offenders-by-crime-type-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "datetime(datum.year, 0, 1)",
      "as": "date"
    },
    {
      "filter": "datum.crime_type === 'Crimes against ownership right' || datum.crime_type === 'Crimes against human heath immunity' || datum.crime_type === 'Crimes against traffic safety and regulation of vehicle use' || datum.crime_type === 'Crimes against environment' || datum.crime_type === 'Crimes against human sexual freedom and immunity' || datum.crime_type === 'Crimes against human right to be live'"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Year",
      "axis": {"format": "%Y", "grid": false, "labelAngle": -30}
    },
    "y": {
      "field": "offenders",
      "type": "quantitative",
      "title": "Number of Offenders",
      "axis": {"format": ","}
    },
    "color": {
      "field": "crime_type",
      "type": "nominal",
      "title": "Crime Type",
      "scale": {
        "domain": [
          "Crimes against ownership right",
          "Crimes against human heath immunity",
          "Crimes against traffic safety and regulation of vehicle use",
          "Crimes against environment",
          "Crimes against human sexual freedom and immunity",
          "Crimes against human right to be live"
        ],
        "range": ["#1565C0", "#C62828", "#F57F17", "#2E7D32", "#00838F", "#6A1B9A"]
      },
      "legend": {"orient": "top"}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"}
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "pointerover", "nearest": true, "clear": "pointerout"}
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "crime_type", "type": "nominal", "title": "Crime Type"},
          {"field": "offenders", "type": "quantitative", "title": "Offenders", "format": ","}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelLimit": 300
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
