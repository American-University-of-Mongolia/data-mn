{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Сонгосон онд хамгийн өндөр үзүүлэлттэй зургаан аймаг, нийслэл. Бүх 22 нутаг дэвсгэрийн мэдээллийг татаж авна.",
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  },
  "data": {
    "url": "/datasets/hay-harvest-by-aimag-mn.csv",
    "format": {
      "type": "csv",
      "parse": {
        "он": "number",
        "утга": "number"
      }
    }
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2025
    }
  ],
  "transform": [
    {
      "filter": "datum['он'] == selectedYear"
    },
    {
      "filter": "isValid(datum['утга'])"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "утга",
          "order": "descending"
        },
        {
          "field": "бүс",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 6"
    }
  ],
  "mark": {
    "type": "bar",
    "color": "#54a24b",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "бүс",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 150
      }
    },
    "x": {
      "field": "утга",
      "type": "quantitative",
      "title": "Өвс, тэжээл (мянган тонн)",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": ",.0f"
      }
    },
    "tooltip": [
      {
        "field": "бүс",
        "type": "nominal",
        "title": "Аймаг, нийслэл"
      },
      {
        "field": "он",
        "type": "quantitative",
        "title": "Он",
        "format": "d"
      },
      {
        "field": "утга",
        "type": "quantitative",
        "title": "Өвс, тэжээл (мянган тонн)",
        "format": ",.2f"
      }
    ]
  }
}
