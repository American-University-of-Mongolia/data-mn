{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Recorded road traffic accidents in Mongolia by region 2000–2024",
  "data": {
    "url": "/datasets/nso-traffic-accidents-by-region-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "datetime(datum.year, 0, 1)",
      "as": "date"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Year",
      "axis": {"format": "%Y", "grid": false, "labelAngle": -30}
    },
    "y": {
      "field": "accidents",
      "type": "quantitative",
      "title": "Road Traffic Accidents",
      "axis": {"format": ","}
    },
    "color": {
      "field": "region",
      "type": "nominal",
      "title": "Region",
      "scale": {
        "domain": ["Ulaanbaatar", "Central region", "Khangai region", "Western region", "Eastern region"],
        "range": ["#1565C0", "#2E7D32", "#F57F17", "#6A1B9A", "#BF360C"]
      },
      "legend": {"orient": "top"}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"}
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "pointerover", "nearest": true, "clear": "pointerout"}
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 60},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year"},
          {"field": "region", "type": "nominal", "title": "Region"},
          {"field": "accidents", "type": "quantitative", "title": "Accidents", "format": ","}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
