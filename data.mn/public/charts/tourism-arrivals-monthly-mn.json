{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсад ирсэн гадаадын жуулчдын тоо 2006–2025",
  "data": {
    "url": "/datasets/tourism-arrivals-monthly-mn.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "datetime(datum.он, 0, 1)",
      "as": "огноо"
    }
  ],
  "encoding": {
    "x": {
      "field": "огноо",
      "type": "temporal",
      "title": "Он",
      "axis": {"format": "%Y", "grid": false, "labelAngle": -30}
    },
    "y": {
      "field": "жуулчид",
      "type": "quantitative",
      "title": "Жуулчдын тоо"
    }
  },
  "layer": [
    {
      "mark": {"type": "area", "opacity": 0.2, "color": "#2E7D32"}
    },
    {
      "mark": {"type": "line", "color": "#2E7D32", "strokeWidth": 2}
    },
    {
      "mark": {"type": "point", "filled": true, "color": "#2E7D32", "size": 60},
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "pointerover", "nearest": true, "clear": "pointerout"}
        }
      ],
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "он", "type": "quantitative", "title": "Он", "format": "d"},
          {"field": "жуулчид", "type": "quantitative", "title": "Жуулчдын тоо", "format": ","}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
