{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "/datasets/registered-vehicles-by-age-mn.csv",
    "format": {
      "type": "csv",
      "parse": {
        "он": "date:'%Y'"
      }
    }
  },
  "mark": {
    "type": "bar",
    "maxBandSize": 48
  },
  "encoding": {
    "x": {
      "field": "он",
      "type": "temporal",
      "title": "Он",
      "axis": {
        "format": "%Y",
        "labelAngle": 0,
        "grid": false
      },
      "timeUnit": "year"
    },
    "y": {
      "field": "тоо",
      "type": "quantitative",
      "title": "Тээврийн хэрэгслийн тоо",
      "stack": "zero",
      "axis": {
        "format": ","
      }
    },
    "color": {
      "field": "насны_бүлэг",
      "type": "nominal",
      "title": "Насжилт",
      "sort": [
        "10 ба түүнээс дээш",
        "7-9",
        "4-6",
        "0-3"
      ],
      "scale": {
        "domain": [
          "10 ба түүнээс дээш",
          "7-9",
          "4-6",
          "0-3"
        ],
        "range": [
          "#1e3a5f",
          "#4c78a8",
          "#72acd4",
          "#b8d4ea"
        ]
      },
      "legend": {
        "orient": "top"
      }
    },
    "tooltip": [
      {
        "field": "он",
        "type": "temporal",
        "title": "Он",
        "format": "%Y",
        "timeUnit": "year"
      },
      {
        "field": "насны_бүлэг",
        "type": "nominal",
        "title": "Насжилт"
      },
      {
        "field": "тоо",
        "type": "quantitative",
        "title": "Тоо",
        "format": ","
      }
    ]
  },
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
