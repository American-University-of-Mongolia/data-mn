{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of infant deaths (under 1 year) in Mongolia from 2010 to 2024.",
  "data": {
    "url": "/datasets/infant-mortality-national-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d",
        "tickMinStep": 2,
        "grid": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Infant Deaths",
      "axis": {
        "format": ",.0f"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "strokeWidth": 2.5,
          "stroke": "#1f77b4"
        },
        "interpolate": "monotone",
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(31, 119, 180, 0.02)"},
            {"offset": 1, "color": "rgba(31, 119, 180, 0.35)"}
          ]
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "year", "title": "Year", "format": "d"},
          {"field": "value", "title": "Infant Deaths", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
