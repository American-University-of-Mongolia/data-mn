[Unit]
Description=data.mn transactional headless Codex dataset update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ritz
WorkingDirectory=/home/ritz/projects/data
ExecStart=/usr/bin/python3 tools/scripts/run_scheduled_dataset_audit.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30000

[Install]
WantedBy=multi-user.target
