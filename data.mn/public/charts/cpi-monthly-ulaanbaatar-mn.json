{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Улаанбаатар хотын сарын инфляци (сараас сард ХҮИ-ийн өөрчлөлт)",
  "data": {
    "url": "/datasets/cpi-monthly-ulaanbaatar-mn.csv?v=2",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "сар",
      "type": "temporal",
      "title": "Сар",
      "axis": {
        "format": "%Y-%m",
        "grid": false,
        "labelAngle": -45
      }
    },
    "y": {
      "field": "утга",
      "type": "quantitative",
      "title": "Сараас сард өөрчлөлт (%)",
      "axis": {
        "format": ".1f"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "color": "#4c78a8",
          "strokeWidth": 2.5
        },
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {
              "offset": 0,
              "color": "rgba(76, 120, 168, 0.01)"
            },
            {
              "offset": 1,
              "color": "rgba(76, 120, 168, 0.3)"
            }
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#4c78a8",
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "сар",
            "title": "Сар",
            "type": "temporal",
            "format": "%Y-%m"
          },
          {
            "field": "утга",
            "title": "Инфляцийн түвшин (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "month": "2025-02",
            "label": "Суурь өөрчлөгдсөн: 2020=100 → 2023=100"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "temporal"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": "height"
        },
        "color": {
          "value": "#64748b"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "month": "2025-02",
            "label": "Суурь өөрчлөгдсөн: 2020=100 → 2023=100"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "dy": -4,
        "baseline": "bottom",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "temporal"
        },
        "y": {
          "value": "height"
        },
        "color": {
          "value": "#64748b"
        },
        "text": {
          "value": [
            "Суурь өөрчлөгдсөн",
            "2020=100 → 2023=100"
          ]
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
