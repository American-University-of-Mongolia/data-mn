{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia total outstanding bank loans monthly trend",
  "data": {
    "url": "/datasets/mongolbank-total-bank-loans-en.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Date",
      "axis": {
        "grid": false,
        "labelAngle": -45
      }
    },
    "y": {
      "field": "total_loans_billion_mnt",
      "type": "quantitative",
      "title": "Total Outstanding Loans (MNT billion)",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": ",.0f",
        "grid": true,
        "gridOpacity": 0.3
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "strokeWidth": 2.5,
          "stroke": "#10b981"
        },
        "interpolate": "monotone",
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {
              "offset": 0,
              "color": "rgba(16, 185, 129, 0.02)"
            },
            {
              "offset": 1,
              "color": "rgba(16, 185, 129, 0.35)"
            }
          ]
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#10b981",
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Date",
            "format": "%Y-%m"
          },
          {
            "field": "total_loans_billion_mnt",
            "type": "quantitative",
            "title": "Total Loans (MNT billion)",
            "format": ",.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
