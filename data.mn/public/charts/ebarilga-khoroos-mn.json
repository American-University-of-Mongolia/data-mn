{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "axis": {
      "labelColor": "#64748b",
      "labelFontSize": 14,
      "titleColor": "#334155",
      "titleFontSize": 16
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  },
  "data": {
    "format": {
      "property": "features",
      "type": "json"
    },
    "url": "/maps/ulaanbaatar-khoroos.json"
  },
  "description": "Улаанбаатар хотын 204 хороо, харьяа дүүргээр нь будаж харуулав, төв цэгээр хамааруулсан (2026 оны 9-р сар). Хороодын нэр дүүргүүдэд давтагддаг; код нь давтагдашгүй. Хил хязгаар: eBarilga геопортал (Хот байгуулалт, хотын стандартын газар).",
  "encoding": {
    "color": {
      "field": "дүүрэг",
      "legend": {
        "orient": "top",
        "title": "Дүүрэг"
      },
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "хороо",
        "title": "Хороо"
      },
      {
        "field": "дүүрэг",
        "title": "Дүүрэг"
      },
      {
        "field": "талбай_км2",
        "format": ",.1f",
        "title": "Талбай (км²)"
      }
    ]
  },
  "mark": {
    "stroke": "white",
    "strokeWidth": 0.5,
    "type": "geoshape"
  },
  "projection": {
    "type": "mercator"
  },
  "transform": [
    {
      "from": {
        "data": {
          "format": {
            "type": "csv"
          },
          "url": "/datasets/ebarilga-khoroos-mn.csv"
        },
        "fields": ["хороо", "дүүрэг", "талбай_км2"],
        "key": "код"
      },
      "lookup": "properties.code"
    }
  ]
}
