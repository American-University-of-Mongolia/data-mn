{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсад импортолсон тээврийн хэрэгслийн жилийн задаргаа: суудлын автомашин, ачааны машин, автобус (2007–2025).",
  "data": {
    "url": "/datasets/imported-vehicles-by-type-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "он",
      "type": "quantitative",
      "title": "Он",
      "axis": {
        "format": "d",
        "tickMinStep": 1,
        "grid": false
      }
    },
    "y": {
      "field": "тоо",
      "type": "quantitative",
      "title": "Импортын тээврийн хэрэгсэл",
      "stack": "zero",
      "axis": {
        "format": ",",
        "grid": true,
        "gridOpacity": 0.3
      }
    },
    "color": {
      "field": "төрөл",
      "type": "nominal",
      "title": "Төрөл",
      "scale": {
        "domain": [
          "Суудлын автомашин",
          "Ачааны тээврийн хэрэгсэл",
          "Автобус, том тээврийн хэрэгсэл"
        ],
        "range": [
          "#4c78a8",
          "#f58518",
          "#72b7b2"
        ]
      },
      "legend": {
        "orient": "top"
      }
    },
    "order": {
      "field": "төрөл",
      "type": "nominal"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.85
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "он",
            "type": "quantitative",
            "title": "Он",
            "format": "d"
          },
          {
            "field": "төрөл",
            "type": "nominal",
            "title": "Төрөл"
          },
          {
            "field": "тоо",
            "type": "quantitative",
            "title": "Тээврийн хэрэгсэл",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}