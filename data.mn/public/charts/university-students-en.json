{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of Students in Universities, Institutes and Colleges in Mongolia by Sex (2010-2025)",
  "data": {
    "url": "/datasets/university-students-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {"format": "d", "tickMinStep": 1, "grid": false}
    },
    "y": {
      "field": "students",
      "type": "quantitative",
      "title": "Number of Students",
      "axis": {"format": ",d"},
      "scale": {"zero": false}
    },
    "color": {
      "field": "sex",
      "type": "nominal",
      "title": "Sex",
      "scale": {
        "domain": ["Female", "Male"],
        "range": ["#e377c2", "#1f77b4"]
      },
      "legend": {"orient": "top"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      }
    },
    {
      "params": [{"name": "hover", "select": {"type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout"}}],
      "mark": {"type": "point", "filled": true, "size": 100},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "sex", "type": "nominal", "title": "Sex"},
          {"field": "students", "type": "quantitative", "title": "Students", "format": ",d"}
        ]
      }
    }
  ],
  "config": {
    "axis": {"labelFontSize": 14, "titleFontSize": 16, "labelColor": "#64748b", "titleColor": "#334155"},
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
