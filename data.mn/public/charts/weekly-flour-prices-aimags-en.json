{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "axis": {
      "labelColor": "#64748b",
      "labelFontSize": 14,
      "titleColor": "#334155",
      "titleFontSize": 16
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  },
  "data": {
    "format": {
      "property": "features",
      "type": "json"
    },
    "url": "/maps/mongolia-aimags.json"
  },
  "description": "Weekly flour prices by aimag in Mongolia, latest week snapshot. Prices joined from the latest-week CSV by aimag name. Boundaries: geoBoundaries (ODbL) / OpenStreetMap contributors. Ulaanbaatar has no data (not covered by the NSO weekly price survey).",
  "encoding": {
    "color": {
      "field": "price",
      "legend": {
        "orient": "top",
        "title": "Price (MNT/kg)"
      },
      "scale": {
        "scheme": "oranges"
      },
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "properties.name",
        "title": "Aimag"
      },
      {
        "field": "price",
        "format": ",.0f",
        "title": "Price (MNT/kg)"
      }
    ]
  },
  "mark": {
    "stroke": "white",
    "strokeWidth": 1,
    "type": "geoshape"
  },
  "projection": {
    "type": "mercator"
  },
  "transform": [
    {
      "from": {
        "data": {
          "format": {
            "type": "csv"
          },
          "url": "/datasets/weekly-flour-prices-aimags-latest-en.csv"
        },
        "fields": [
          "price"
        ],
        "key": "name"
      },
      "lookup": "properties.name"
    }
  ]
}
