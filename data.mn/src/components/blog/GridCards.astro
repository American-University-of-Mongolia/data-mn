---
/**
 * GridCards Component
 *
 * Displays content in a grid layout with image cards
 * Used for data pages and reports listings
 */

import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
  showCategory?: boolean;
  showTags?: boolean;
  contentType?: 'data' | 'insights' | 'reports';
}

const { posts, showCategory = true, showTags = false, contentType = 'data' } = Astro.props;

// For data cards: hide date and author
// For insights/reports: show date, hide author (which is usually "data.mn")
const showDate = contentType !== 'data';
const showAuthor = false; // Remove "data.mn" label from all card types

/**
 * Get thumbnail URL for data pages using naming convention
 * Convention: /en/data/population-total → /thumbnails/population-total-en.webp
 */
function getThumbnailUrl(post: Post): string | null {
  if (contentType !== 'data') return null;

  const match = post.permalink.match(/\/(en|mn)\/data\/(.+)/);
  if (match) {
    const [, lang, slug] = match;
    return `/thumbnails/${slug}-${lang}.webp`;
  }
  return null;
}

// Check if URL is a generated thumbnail (from public/thumbnails)
function isThumbnailUrl(url: string | null): boolean {
  return url?.startsWith('/thumbnails/') ?? false;
}
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {
    posts.map((post) => {
      // Use explicit image, or inferred thumbnail for data pages, or null for placeholder
      const imageUrl = post.image || getThumbnailUrl(post);

      return (
      <article
        class="group relative flex flex-col h-full bg-white dark:bg-slate-900 rounded-lg border border-gray-200 dark:border-slate-800 overflow-hidden transition-all duration-200 hover:shadow-[0_12px_24px_-8px_rgba(0,0,0,0.15)] dark:hover:shadow-[0_12px_24px_-8px_rgba(0,0,0,0.4)] hover:border-primary dark:hover:border-primary hover:-translate-y-1"
        data-category={post.category?.title || ''}
      >
        <a href={post.permalink} class="block">
          {imageUrl && isThumbnailUrl(imageUrl) ? (
            /* Use native img for generated thumbnails from public/thumbnails */
            <div class="relative aspect-video overflow-hidden">
              <img
                src={imageUrl}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
                width={800}
                height={450}
                alt={post.title}
                loading="lazy"
                decoding="async"
              />
              {showCategory && post.category && (
                <div class="absolute top-3 left-3">
                  <span class="inline-block px-3 py-1 text-xs font-semibold bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 rounded-full shadow-sm">
                    {post.category.title}
                  </span>
                </div>
              )}
            </div>
          ) : imageUrl ? (
            /* Use optimized Image component for other images */
            <div class="relative aspect-video overflow-hidden">
              <Image
                src={imageUrl}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
                widths={[400, 768]}
                width={800}
                height={450}
                sizes="(max-width: 768px) 100vw, 400px"
                alt={post.title}
                aspectRatio="16:9"
                loading="lazy"
                decoding="async"
              />
              {showCategory && post.category && (
                <div class="absolute top-3 left-3">
                  <span class="inline-block px-3 py-1 text-xs font-semibold bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 rounded-full shadow-sm">
                    {post.category.title}
                  </span>
                </div>
              )}
            </div>
          ) : (
            <div class="relative aspect-video bg-gradient-to-br from-[var(--aw-color-primary)]/15 via-[var(--aw-color-secondary)]/10 to-[var(--aw-color-accent)]/5 dark:from-[var(--aw-color-primary)]/20 dark:via-[var(--aw-color-secondary)]/10 dark:to-transparent">
              <div class="absolute inset-0 flex items-center justify-center">
                <Icon name="tabler:chart-bar" class="w-16 h-16 text-primary/40" />
              </div>
              {showCategory && post.category && (
                <div class="absolute top-3 left-3">
                  <span class="inline-block px-3 py-1 text-xs font-semibold bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 rounded-full shadow-sm">
                    {post.category.title}
                  </span>
                </div>
              )}
            </div>
          )}
        </a>

        <div class="flex flex-col flex-grow p-5">
          <header class="mb-3">
            <h2 class="text-xl font-bold leading-tight mb-2">
              <a
                href={post.permalink}
                class="text-gray-900 dark:text-gray-100 hover:text-primary dark:hover:text-primary transition-colors"
              >
                {post.title}
              </a>
            </h2>

            {post.excerpt && (
              <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{post.excerpt}</p>
            )}
          </header>

          <div class="mt-auto">
            {showTags && post.tags && post.tags.length > 0 && (
              <div class="flex flex-wrap gap-1 mb-3">
                {post.tags.slice(0, 3).map((tag) => (
                  <a
                    href={`?tag=${tag.slug}`}
                    class="inline-block px-2 py-1 text-xs bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 rounded hover:bg-primary hover:text-white transition-colors"
                  >
                    {tag.title}
                  </a>
                ))}
              </div>
            )}

            {(showDate || showAuthor) && (
              <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                {showDate && post.publishDate && (
                  <time datetime={post.publishDate.toISOString()} class="flex items-center gap-1">
                    <Icon name="tabler:calendar" class="w-4 h-4" />
                    {post.publishDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                )}
                {showAuthor && post.author && <span class="text-gray-600 dark:text-gray-400">{post.author}</span>}
              </div>
            )}
          </div>
        </div>
      </article>
    )})
  }
</div>

{
  posts.length === 0 && (
    <div class="text-center py-12">
      <Icon name="tabler:folder-open" class="w-16 h-16 mx-auto mb-4 text-gray-400" />
      <p class="text-xl text-gray-600 dark:text-gray-400">No content found</p>
    </div>
  )
}

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
