{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "MRPAM cumulative state budget revenue plan and actual performance by report month, in million MNT.",
  "data": {
    "url": "/datasets/mrpam-budget-revenue-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "temporal",
      "title": "Report month",
      "axis": {"format": "%b %Y", "grid": false, "labelOverlap": "greedy"}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Million MNT",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "metric",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Annual plan", "Actual to date"],
        "range": ["#4c78a8", "#f58518"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 2.5}},
    {
      "params": [{
        "name": "hover",
        "select": {
          "type": "point",
          "fields": ["month"],
          "nearest": true,
          "on": "pointerover",
          "clear": "pointerout"
        }
      }],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "month", "type": "temporal", "title": "Report month", "format": "%B %Y"},
          {"field": "metric", "type": "nominal", "title": "Series"},
          {"field": "value", "type": "quantitative", "title": "Million MNT", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
