{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly inflation rate in Ulaanbaatar (month-over-month CPI change)",
  "data": {
    "url": "/datasets/cpi-monthly-ulaanbaatar-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "temporal",
      "title": "Month",
      "axis": {"format": "%Y-%m", "grid": false, "labelAngle": -45}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Month-over-Month Change (%)",
      "axis": {"format": ".1f"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"color": "#4c78a8", "strokeWidth": 2.5},
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(76, 120, 168, 0.01)"},
            {"offset": 1, "color": "rgba(76, 120, 168, 0.3)"}
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#4c78a8",
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "month", "title": "Month", "type": "temporal", "format": "%Y-%m"},
          {"field": "value", "title": "Inflation Rate (%)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
