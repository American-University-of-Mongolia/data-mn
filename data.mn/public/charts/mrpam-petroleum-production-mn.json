{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын газрын тосны сарын олборлолт, экспортын хэмжээ, 2021 оны 1 сараас 2026 оны 7 сар хүртэл, баррелиар. Экспортын хоосон утга нь эх тайланд мэдээлээгүй үеийг илэрхийлнэ.",
  "data": {
    "url": "/datasets/mrpam-petroleum-production-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "сар",
      "type": "temporal",
      "title": "Сар",
      "axis": {"format": "%Y", "grid": false}
    },
    "y": {
      "field": "утга",
      "type": "quantitative",
      "title": "Баррель",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "үзүүлэлт",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Олборлолт", "Экспорт"],
        "range": ["#4c78a8", "#f58518"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5}
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "сар", "type": "temporal", "title": "Сар", "format": "%Y-%m"},
          {"field": "үзүүлэлт", "type": "nominal", "title": "Үзүүлэлт"},
          {"field": "утга", "type": "quantitative", "title": "Баррель", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
