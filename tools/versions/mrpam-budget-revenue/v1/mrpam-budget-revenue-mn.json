{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "АМГТГ-ын улсын төсөвт төвлөрүүлэх орлогын төлөвлөгөө ба тайлант сарын гүйцэтгэл, сая төгрөгөөр.",
  "data": {
    "url": "/datasets/mrpam-budget-revenue-mn.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "datetime(datum.он, datum.сар - 1, 1)", "as": "огноо"},
    {"fold": ["төлөвлөгөө_сая_төг", "гүйцэтгэл_сая_төг"], "as": ["үзүүлэлт", "сая_төгрөг"]},
    {"calculate": "datum.үзүүлэлт === 'төлөвлөгөө_сая_төг' ? 'Жилийн төлөвлөгөө' : 'Өссөн дүнгийн гүйцэтгэл'", "as": "цуваа"}
  ],
  "encoding": {
    "x": {
      "field": "огноо",
      "type": "temporal",
      "title": "Тайлант сар",
      "axis": {"format": "%Y-%m", "grid": false, "labelOverlap": "greedy"}
    },
    "y": {
      "field": "сая_төгрөг",
      "type": "quantitative",
      "title": "Сая төгрөг",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "цуваа",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Жилийн төлөвлөгөө", "Өссөн дүнгийн гүйцэтгэл"],
        "range": ["#4c78a8", "#f58518"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 2.5}},
    {
      "params": [{
        "name": "hover",
        "select": {
          "type": "point",
          "fields": ["огноо"],
          "nearest": true,
          "on": "pointerover",
          "clear": "pointerout"
        }
      }],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "огноо", "type": "temporal", "title": "Тайлант сар", "format": "%Y-%m"},
          {"field": "цуваа", "type": "nominal", "title": "Үзүүлэлт"},
          {"field": "сая_төгрөг", "type": "quantitative", "title": "Сая төгрөг", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
