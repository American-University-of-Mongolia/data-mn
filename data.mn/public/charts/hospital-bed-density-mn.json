{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын мянган хүн тутамд ноогдох эмнэлгийн ортын тоо 1989-2024",
  "data": {
    "url": "/datasets/hospital-bed-density-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "он",
      "type": "quantitative",
      "title": "Он",
      "axis": {"format": "d", "tickMinStep": 5, "grid": false}
    },
    "y": {
      "field": "мянган_хүн_тутамд_ор",
      "type": "quantitative",
      "title": "Мянган хүнд ноогдох ор",
      "axis": {"format": ".1f"},
      "scale": {"zero": false}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"color": "#10b981", "strokeWidth": 2.5},
        "color": {
          "x1": 1, "y1": 1, "x2": 1, "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(16, 185, 129, 0.01)"},
            {"offset": 1, "color": "rgba(16, 185, 129, 0.3)"}
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [{"name": "hover", "select": {"type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout"}}],
      "mark": {"type": "point", "filled": true, "color": "#10b981", "size": 100},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "он", "title": "Он", "format": "d"},
          {"field": "мянган_хүн_тутамд_ор", "title": "Мянган хүнд ноогдох ор", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
