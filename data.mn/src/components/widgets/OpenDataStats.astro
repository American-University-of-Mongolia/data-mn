---
/**
 * OpenDataStats - E-Mongolia style open data dashboard section
 *
 * Features:
 * - Hero card with Mongolia map background
 * - 8 stat cards with values, icons, and optional sparklines
 * - Responsive grid layout (2 cols mobile, 3-4 cols desktop)
 * - Links to relevant data pages
 * - Language-aware translations
 */

import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Sparkline from '~/components/ui/Sparkline.astro';
import MongoliaMap from '~/components/ui/MongoliaMap.astro';
import { useTranslations, type Language } from '~/i18n';

interface StatCard {
  title: string;
  value: string;
  unit?: string;
  icon?: string;
  link: string;
  sparklineData?: number[];
  color?: string;
}

interface Props {
  title?: string;
  lang?: Language;
  heroStat?: {
    title: string;
    value: string;
    link: string;
  };
  stats?: StatCard[];
}

const { title, lang = 'mn' } = Astro.props;
const t = useTranslations(lang);

// Default title from translations if not provided
const sectionTitle = title || t('home.keyIndicators');

// Build language-aware links
const langPrefix = `/${lang}`;

// Default hero stat with translations
// Data: 2024 population from NSO (population-total-mongolia dataset)
const heroStat = Astro.props.heroStat || {
  title: t('stats.population'),
  value: '3,544,835',
  link: `${langPrefix}/data/population-total-mongolia`,
};

// Default stats with translations
// All values from actual dataset CSVs as of 2024
// Sparkline data: last 15 years (2010-2024) for trend visualization
const stats: StatCard[] = Astro.props.stats || [
  {
    // Data: inflation-annual dataset (2024 value: 9.0%)
    // Sparkline: 2010-2024 annual inflation rates
    title: t('stats.inflation'),
    value: '9.0',
    unit: t('unit.percent'),
    link: `${langPrefix}/data/inflation-annual`,
    sparklineData: [13.0, 8.9, 14.0, 12.5, 11.0, 1.9, 1.3, 6.4, 8.1, 5.2, 2.3, 13.8, 13.2, 7.9, 9.0],
  },
  {
    // Data: unemployment-rate-national dataset (2024 value: 5.9%)
    // Sparkline: 2010-2024 unemployment rates
    title: t('stats.unemployment'),
    value: '5.9',
    unit: t('unit.percent'),
    link: `${langPrefix}/data/unemployment-rate-national`,
    sparklineData: [9.9, 7.7, 8.2, 7.9, 7.9, 7.5, 10.0, 8.8, 7.8, 9.9, 6.7, 8.3, 6.4, 5.3, 5.9],
  },
  {
    // Data: labor-participation-national dataset (2024 value: 61.3%)
    title: t('stats.laborForce'),
    value: '61.3',
    unit: t('unit.percent'),
    icon: '🤝',
    link: `${langPrefix}/data/labor-participation-national`,
  },
  {
    // Data: gdp-nominal dataset (2024 value: 80.66 trillion MNT)
    // Sparkline: 2010-2024 GDP in trillion MNT (values divided by 1,000,000 from million MNT)
    title: t('stats.gdp'),
    value: '80.7',
    unit: t('unit.trillionMNT'),
    link: `${langPrefix}/data/gdp-nominal`,
    sparklineData: [9.8, 13.2, 16.7, 19.2, 22.2, 22.9, 23.9, 28.0, 32.6, 37.8, 37.5, 43.6, 53.9, 70.4, 80.7],
    color: '#2563eb',
  },
  {
    // Data: livestock-total dataset (2024 value: 57.65 million)
    // Sparkline: 2010-2024 livestock in millions
    title: t('stats.livestock'),
    value: '57.6',
    unit: t('unit.million'),
    link: `${langPrefix}/data/livestock-total`,
    sparklineData: [32.7, 36.3, 40.9, 45.1, 52.0, 56.0, 61.5, 66.2, 66.5, 71.0, 67.1, 67.3, 71.1, 64.7, 57.6],
  },
  {
    // Data: salary-average-national dataset (2024 value: 2,332.4K MNT = 2.33M)
    title: t('stats.salary'),
    value: '2.3',
    unit: t('unit.millionMNT'),
    icon: '💼',
    link: `${langPrefix}/data/salary-average-national`,
  },
  {
    // Data: household-income-total dataset (2024 value: 2,567,889 MNT = 2.57M)
    title: t('stats.householdIncome'),
    value: '2.6',
    unit: t('unit.millionMNT'),
    icon: '💵',
    link: `${langPrefix}/data/household-income-total`,
  },
  {
    // Data: trade-total dataset (2024 value: $27.4 billion USD)
    // Sparkline: 2010-2024 trade in billions USD
    title: t('stats.trade'),
    value: '27.4',
    unit: t('unit.billionUSD'),
    link: `${langPrefix}/data/trade-total`,
    sparklineData: [6.1, 11.4, 11.1, 10.6, 11.0, 8.5, 8.3, 10.5, 12.9, 13.7, 12.9, 16.1, 21.2, 24.4, 27.4],
  },
];

// Split stats for layout: first 2 are in the left column with hero, rest in right
const leftStats = stats.slice(0, 2);
const rightStats = stats.slice(2);
---

<WidgetWrapper containerClass="max-w-7xl py-6 md:py-8 lg:py-10">
  <!-- Mobile Layout: Simple 2-column grid -->
  <div class="block lg:hidden">
    <!-- Hero Card -->
    <a
      href={heroStat.link}
      class="group block mb-4 relative overflow-hidden rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 dark:from-slate-800 dark:to-slate-900 p-6 min-h-[140px] hover:shadow-lg transition-all border border-blue-100 dark:border-slate-700"
    >
      <div class="absolute inset-0 opacity-30 overflow-hidden">
        <MongoliaMap class="w-full h-full scale-150 translate-x-4" />
      </div>
      <div class="absolute top-6 left-6 z-10">
        <p class="text-lg font-semibold text-gray-700 dark:text-gray-300">{heroStat.title}</p>
      </div>
      <div class="absolute bottom-6 left-6 z-10">
        <div class="flex items-center gap-3">
          <span class="text-4xl font-bold text-gray-900 dark:text-white">{heroStat.value}</span>
          <span class="text-2xl">🇲🇳</span>
        </div>
      </div>
    </a>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 gap-3">
      {
        stats.map((stat) => (
          <a
            href={stat.link}
            class:list={[
              'group relative flex flex-col bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-primary dark:hover:border-primary hover:shadow-md transition-all overflow-hidden',
              stat.sparklineData ? 'row-span-2 min-h-[160px]' : 'p-4',
            ]}
          >
            {stat.sparklineData ? (
              /* Sparkline card - full width chart edge to edge */
              <>
                <div class="absolute top-4 left-4 z-10">
                  <p class="text-sm font-semibold text-gray-600 dark:text-gray-400">{stat.title}</p>
                </div>
                <div class="absolute inset-x-0 bottom-0 h-2/3 overflow-hidden">
                  <Sparkline data={stat.sparklineData} width={200} height={100} color={stat.color || '#2563eb'} class="w-full h-full" />
                </div>
                <div class="absolute bottom-4 left-4 z-10">
                  <span class="text-2xl font-bold text-primary">
                    {stat.value}
                    {stat.unit && <span class="text-lg font-normal text-gray-600 dark:text-gray-400">{stat.unit}</span>}
                  </span>
                </div>
              </>
            ) : (
              /* Regular card with icon */
              <>
                <p class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-2 line-clamp-2">{stat.title}</p>
                <div class="flex items-end justify-between mt-auto">
                  <span class="text-2xl font-bold text-primary">
                    {stat.value}
                    {stat.unit && <span class="text-lg font-normal text-gray-600 dark:text-gray-400">{stat.unit}</span>}
                  </span>
                  {stat.icon && <span class="text-4xl">{stat.icon}</span>}
                </div>
              </>
            )}
          </a>
        ))
      }
    </div>
  </div>

  <!-- Desktop Layout: Complex grid matching E-Mongolia -->
  <div class="hidden lg:grid lg:grid-cols-4 gap-4">
    <!-- Left Column: Hero + 2 stats -->
    <div class="col-span-2 flex flex-col gap-4">
      <!-- Hero Card with Map -->
      <a
        href={heroStat.link}
        class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 dark:from-slate-800 dark:to-slate-900 p-8 hover:shadow-lg transition-all border border-blue-100 dark:border-slate-700 flex-grow"
      >
        <div class="absolute inset-0 opacity-40 overflow-hidden">
          <MongoliaMap class="w-full h-full scale-150 translate-x-8" />
        </div>
        <div class="absolute top-8 left-8 z-10">
          <p class="text-xl font-semibold text-gray-700 dark:text-gray-300">{heroStat.title}</p>
        </div>
        <div class="absolute bottom-8 left-8 z-10">
          <div class="flex items-center gap-4">
            <span class="text-5xl font-bold text-gray-900 dark:text-white">{heroStat.value}</span>
            <span class="text-3xl">🇲🇳</span>
          </div>
        </div>
      </a>

      <!-- Two stats below hero -->
      <div class="grid grid-cols-2 gap-4">
        {
          leftStats.map((stat) => (
            <a
              href={stat.link}
              class:list={[
                'group relative flex flex-col bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-primary dark:hover:border-primary hover:shadow-md transition-all overflow-hidden',
                stat.sparklineData ? 'min-h-[180px]' : 'p-5 min-h-[120px]',
              ]}
            >
              {stat.sparklineData ? (
                /* Sparkline card - full width chart edge to edge */
                <>
                  <div class="absolute top-5 left-5 z-10">
                    <p class="text-sm font-semibold text-gray-600 dark:text-gray-400">{stat.title}</p>
                  </div>
                  <div class="absolute inset-x-0 bottom-0 h-2/3 overflow-hidden">
                    <Sparkline data={stat.sparklineData} width={250} height={100} color={stat.color || '#2563eb'} class="w-full h-full" />
                  </div>
                  <div class="absolute bottom-5 left-5 z-10">
                    <span class="text-3xl font-bold text-primary">
                      {stat.value}
                      {stat.unit && <span class="text-lg font-normal text-gray-600 dark:text-gray-400">{stat.unit}</span>}
                    </span>
                  </div>
                </>
              ) : (
                /* Regular card with icon */
                <>
                  <p class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-3">{stat.title}</p>
                  <div class="flex items-end justify-between mt-auto">
                    <span class="text-3xl font-bold text-primary">
                      {stat.value}
                      {stat.unit && <span class="text-lg font-normal text-gray-600 dark:text-gray-400">{stat.unit}</span>}
                    </span>
                    {stat.icon && <span class="text-5xl">{stat.icon}</span>}
                  </div>
                </>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Right Column: 6 stats in 2x3 grid -->
    <div class="col-span-2 grid grid-cols-2 gap-4">
      {
        rightStats.map((stat) => (
          <a
            href={stat.link}
            class:list={[
              'group relative flex flex-col bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-primary dark:hover:border-primary hover:shadow-md transition-all overflow-hidden',
              stat.sparklineData ? 'min-h-[180px]' : 'p-5 min-h-[120px]',
            ]}
          >
            {stat.sparklineData ? (
              /* Sparkline card - full width chart edge to edge */
              <>
                <div class="absolute top-5 left-5 z-10">
                  <p class="text-sm font-semibold text-gray-600 dark:text-gray-400 line-clamp-2">{stat.title}</p>
                </div>
                <div class="absolute inset-x-0 bottom-0 h-2/3 overflow-hidden">
                  <Sparkline data={stat.sparklineData} width={250} height={100} color={stat.color || '#2563eb'} class="w-full h-full" />
                </div>
                <div class="absolute bottom-5 left-5 z-10">
                  <span class="text-2xl font-bold text-primary">
                    {stat.value}
                    {stat.unit && <span class="text-base font-normal text-gray-600 dark:text-gray-400">{stat.unit}</span>}
                  </span>
                </div>
              </>
            ) : (
              /* Regular card with icon */
              <>
                <p class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-3 line-clamp-2">{stat.title}</p>
                <div class="flex items-end justify-between mt-auto">
                  <span class="text-2xl font-bold text-primary">
                    {stat.value}
                    {stat.unit && <span class="text-base font-normal text-gray-600 dark:text-gray-400">{stat.unit}</span>}
                  </span>
                  {stat.icon && <span class="text-4xl">{stat.icon}</span>}
                </div>
              </>
            )}
          </a>
        ))
      }
    </div>
  </div>
</WidgetWrapper>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
