{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia's total meat production from 2010 to 2024",
  "data": {
    "url": "/datasets/meat-production-total-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {"format": "d", "tickMinStep": 2, "grid": false}
    },
    "y": {
      "field": "production_tonnes",
      "type": "quantitative",
      "title": "Tonnes",
      "axis": {"format": ",.0f"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"color": "#3b82f6", "strokeWidth": 2.5},
        "color": {
          "x1": 1, "y1": 1, "x2": 1, "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(59, 130, 246, 0.01)"},
            {"offset": 1, "color": "rgba(59, 130, 246, 0.3)"}
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [{"name": "hover", "select": {"type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout"}}],
      "mark": {"type": "point", "filled": true, "color": "#3b82f6", "size": 100},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "year", "title": "Year", "format": "d"},
          {"field": "production_tonnes", "title": "Production (tonnes)", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {"labelFontSize": 14, "titleFontSize": 16, "labelColor": "#64748b", "titleColor": "#334155"},
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
