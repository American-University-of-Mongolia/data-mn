{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia international investment position — assets, liabilities, and net IIP (quarterly)",
  "data": {
    "url": "/datasets/mongolbank-international-investment-en.csv",
    "format": { "type": "csv" }
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Quarter",
      "axis": { "grid": false, "labelAngle": -45 }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "USD Million",
      "axis": { "format": ",.0f", "grid": true, "gridOpacity": 0.3 }
    },
    "color": {
      "field": "metric",
      "type": "nominal",
      "title": "Position",
      "scale": {
        "domain": ["Total Assets", "Total Liabilities", "Net IIP"],
        "range": ["#10b981", "#f97316", "#3b82f6"]
      },
      "legend": { "orient": "top" }
    }
  },
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 2, "interpolate": "monotone" }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": { "type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout" }
        }
      ],
      "mark": { "type": "point", "filled": true, "size": 60 },
      "encoding": {
        "opacity": {
          "condition": { "param": "hover", "empty": false, "value": 1 },
          "value": 0
        },
        "tooltip": [
          { "field": "date", "type": "temporal", "title": "Quarter", "format": "%Y Q%q" },
          { "field": "metric", "type": "nominal", "title": "Item" },
          { "field": "value", "type": "quantitative", "title": "USD million", "format": ",.1f" }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": "transparent" },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": { "labelFontSize": 13, "titleFontSize": 14 }
  }
}
