{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of registered vehicles in Mongolia from 1940 to 2025",
  "data": {
    "url": "/datasets/registered-vehicles-national-en.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "temporal",
      "timeUnit": "year",
      "title": "Year",
      "axis": {
        "format": "%Y",
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "vehicles",
      "type": "quantitative",
      "title": "Registered Vehicles",
      "axis": {
        "format": ",.0f"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "stroke": "#6366f1",
          "strokeWidth": 2
        },
        "point": false,
        "opacity": 0.7,
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {
              "offset": 0,
              "color": "rgba(99, 102, 241, 0.02)"
            },
            {
              "offset": 1,
              "color": "rgba(99, 102, 241, 0.35)"
            }
          ]
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "year",
            "type": "temporal",
            "timeUnit": "year",
            "title": "Year",
            "format": "%Y"
          },
          {
            "field": "vehicles",
            "type": "quantitative",
            "title": "Registered Vehicles",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "strokeWidth": 0,
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
