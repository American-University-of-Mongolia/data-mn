{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Production of major industrial commodities in Mongolia (1989–2024).",
  "data": {
    "url": "/datasets/industrial-production-national-en.csv",
    "format": { "type": "csv" }
  },
  "transform": [
    {
      "filter": {
        "field": "commodity",
        "oneOf": ["Coal (thousand tonnes)", "Copper concentrate (35%) (thousand tonnes)", "Crude oil (thousand barrels)", "Electricity (million kWh)", "Gold (kg)", "Iron ore (thousand tonnes)", "Molybdenum concentrate (47%) (tonnes)"]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": { "format": "d", "tickMinStep": 5, "grid": false }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Production (see unit per commodity)",
      "axis": { "format": ",.0f" }
    },
    "color": {
      "field": "commodity",
      "type": "nominal",
      "title": "Commodity",
      "scale": {
        "domain": ["Coal (thousand tonnes)", "Copper concentrate (35%) (thousand tonnes)", "Crude oil (thousand barrels)", "Electricity (million kWh)", "Gold (kg)", "Iron ore (thousand tonnes)", "Molybdenum concentrate (47%) (tonnes)"],
        "range": ["#475569", "#f59e0b", "#eab308", "#3b82f6", "#10b981", "#6366f1", "#ec4899"]
      },
      "legend": { "orient": "top" }
    }
  },
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 2, "interpolate": "monotone" }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout",
            "fields": ["year"]
          }
        }
      ],
      "mark": { "type": "point", "filled": true, "size": 60 },
      "encoding": {
        "opacity": {
          "condition": { "param": "hover", "empty": false, "value": 1 },
          "value": 0
        },
        "tooltip": [
          { "field": "year", "type": "quantitative", "title": "Year", "format": "d" },
          { "field": "commodity", "type": "nominal", "title": "Commodity" },
          { "field": "value", "type": "quantitative", "title": "Value", "format": ",.1f" }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": { "stroke": "transparent" },
    "legend": { "labelFontSize": 13, "titleFontSize": 14 }
  }
}
