{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia household monthly average expenditure by location (National, Urban, Rural) from 1997 to 2024",
  "data": {
    "url": "/datasets/household-expenditure-by-location-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {"format": "d", "tickMinStep": 5, "grid": false}
    },
    "y": {
      "field": "expenditure_mnt",
      "type": "quantitative",
      "title": "Monthly Expenditure (MNT)",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "location",
      "type": "nominal",
      "title": "Location",
      "scale": {
        "domain": ["National", "Urban", "Rural"],
        "range": ["#3b82f6", "#ef4444", "#10b981"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"}
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "location", "type": "nominal", "title": "Location"},
          {"field": "expenditure_mnt", "type": "quantitative", "title": "Expenditure (MNT)", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
