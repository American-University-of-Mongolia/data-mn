{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын барааны худалдааны тэнцэл (2009-2026). Сарын экспорт, импорт, цэвэр тэнцэл сая ам.доллараар.",
  "data": {
    "url": "/datasets/bop-trade-balance-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "сар",
      "type": "temporal",
      "title": "Сар",
      "axis": {
        "format": "%Y",
        "tickCount": 8,
        "grid": false
      }
    },
    "y": {
      "field": "утга",
      "type": "quantitative",
      "title": "Сая ам.доллар",
      "axis": {
        "format": ".0f"
      }
    },
    "color": {
      "field": "үзүүлэлт",
      "type": "nominal",
      "scale": {
        "domain": [
          "Экспорт",
          "Импорт",
          "Цэвэр тэнцэл"
        ]
      },
      "legend": {
        "title": "Ангилал",
        "orient": "top"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "сар",
            "type": "temporal",
            "title": "Сар",
            "format": "%Y-%m"
          },
          {
            "field": "үзүүлэлт",
            "type": "nominal",
            "title": "Төрөл"
          },
          {
            "field": "утга",
            "type": "quantitative",
            "title": "Сая ам.доллар",
            "format": ",.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  }
}