{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of registered vehicles by province in Mongolia, 2025",
  "data": {
    "url": "/datasets/registered-vehicles-by-province-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "filter": "datum.year == 2025"
    }
  ],
  "mark": {
    "type": "bar",
    "color": "#4c78a8",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "count",
      "type": "quantitative",
      "title": "Registered Vehicles",
      "axis": {"format": ",.0f", "grid": true, "gridOpacity": 0.3}
    },
    "y": {
      "field": "province",
      "type": "nominal",
      "title": null,
      "sort": "-x"
    },
    "tooltip": [
      {"field": "province", "type": "nominal", "title": "Province"},
      {"field": "count", "type": "quantitative", "title": "Registered Vehicles", "format": ",.0f"}
    ]
  },
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    }
  }
}
