{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын нефтийн бүтээгдэхүүний сарын импортын хэмжээ, 2021 оны 1 сараас 2026 оны 6 сар. Эх үүсвэрийн дутуу утгыг шугамын тасралтаар харуулав.",
  "data": {
    "url": "/datasets/mrpam-petroleum-imports-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datetime(datum['он'] - 0, datum['сар'] - 1)",
      "as": "date"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Огноо",
      "axis": {
        "format": "%Y",
        "grid": false,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "хэмжээ_тн",
      "type": "quantitative",
      "title": "Хэмжээ (тонн)",
      "axis": {
        "format": ",.0f"
      }
    },
    "color": {
      "field": "бүтээгдэхүүн",
      "type": "nominal",
      "title": "Бүтээгдэхүүн",
      "legend": {
        "orient": "top",
        "title": null
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "linear"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Огноо",
            "format": "%B %Y"
          },
          {
            "field": "бүтээгдэхүүн",
            "title": "Бүтээгдэхүүн",
            "type": "nominal"
          },
          {
            "field": "хэмжээ_тн",
            "title": "Хэмжээ (тонн)",
            "format": ",.0f",
            "type": "quantitative"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
