{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly crude petroleum production and exports in Mongolia from January 2021 through June 2026, in barrels. Missing exports reflect source reports with no reported value.",
  "data": {
    "url": "/datasets/mrpam-petroleum-production-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
    {"fold": ["production_barrels", "export_barrels"], "as": ["metric", "barrels"]},
    {"calculate": "datum.metric === 'production_barrels' ? 'Production' : 'Exports'", "as": "series"}
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Month",
      "axis": {"format": "%b %Y", "grid": false, "labelOverlap": "greedy"}
    },
    "y": {
      "field": "barrels",
      "type": "quantitative",
      "title": "Barrels",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "series",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Production", "Exports"],
        "range": ["#4c78a8", "#f58518"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5}
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["date"],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Month", "format": "%B %Y"},
          {"field": "series", "type": "nominal", "title": "Series"},
          {"field": "barrels", "type": "quantitative", "title": "Barrels", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
