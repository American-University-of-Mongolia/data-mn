{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Weekly fuel prices in Ulaanbaatar from 2021-2025, showing petrol (A-80, A-92) and diesel.",
  "data": {
    "url": "/datasets/weekly-fuel-prices-ulaanbaatar-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Огноо",
      "axis": {
        "grid": false,
        "format": "%b %Y"
      }
    },
    "y": {
      "field": "price",
      "type": "quantitative",
      "title": "Үнэ (төг/л)",
      "axis": {
        "format": ",.0f"
      }
    },
    "color": {
      "field": "product",
      "type": "nominal",
      "legend": {
        "orient": "top",
        "title": "Шатахууны төрөл"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "product",
            "title": "Шатахууны төрөл"
          },
          {
            "field": "date",
            "type": "temporal",
            "title": "Огноо",
            "format": "%Y-%m-%d"
          },
          {
            "field": "price",
            "title": "Үнэ",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  }
}