{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын аж үйлдвэрийн нийт бүтээгдэхүүн сараар (тэрбум төгрөг)",
  "data": {
    "url": "/datasets/industrial-output-total-monthly-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "огноо",
      "type": "temporal",
      "timeUnit": "yearmonth",
      "title": "Сар",
      "axis": {"format": "%Y", "labelAngle": -45, "grid": false}
    },
    "y": {
      "field": "утга",
      "type": "quantitative",
      "title": "Бүтээгдэхүүн (тэрбум төгрөг)",
      "axis": {"format": ",.0f"},
      "scale": {"zero": true}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"color": "#4c78a8", "strokeWidth": 2.5},
        "color": {
          "x1": 1, "y1": 1, "x2": 1, "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(76, 120, 168, 0.01)"},
            {"offset": 1, "color": "rgba(76, 120, 168, 0.3)"}
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "color": "#4c78a8", "size": 100},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "огноо", "type": "temporal", "timeUnit": "yearmonth", "title": "Сар", "format": "%b %Y"},
          {"field": "утга", "type": "quantitative", "title": "Бүтээгдэхүүн (тэрбум төгрөг)", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
