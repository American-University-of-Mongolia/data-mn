{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "National monthly exploration and extraction permit counts in Mongolia.",
  "data": {
    "url": "/datasets/mrpam-mining-permits-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
    {"fold": ["exploration_count", "extraction_count"], "as": ["metric", "count"]},
    {
      "calculate": "datum.metric === 'exploration_count' ? 'Exploration' : 'Extraction'",
      "as": "permit_type"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Month",
      "axis": {"format": "%Y-%m", "labelAngle": -45, "grid": false}
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Permit count",
      "scale": {"zero": true},
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "permit_type",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Exploration", "Extraction"],
        "range": ["#4c78a8", "#f58518"]
      },
      "legend": {"orient": "top"}
    }
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 2.5}},
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["date"],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Month", "format": "%Y-%m"},
          {"field": "permit_type", "type": "nominal", "title": "Permit type"},
          {"field": "count", "type": "quantitative", "title": "Count", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
