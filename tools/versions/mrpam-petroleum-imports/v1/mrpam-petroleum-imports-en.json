{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly petroleum product imports into Mongolia from January 2021 through June 2026. Source-missing values appear as line gaps.",
  "data": {
    "url": "/datasets/mrpam-petroleum-imports-en.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datetime(datum['year'] - 0, datum['month'] - 1)",
      "as": "date"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Date",
      "axis": {
        "format": "%Y",
        "grid": false,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "volume_t",
      "type": "quantitative",
      "title": "Volume (tonnes)",
      "axis": {
        "format": ",.0f"
      }
    },
    "color": {
      "field": "product",
      "type": "nominal",
      "title": "Product",
      "legend": {
        "orient": "top",
        "title": null
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "linear"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Date",
            "format": "%B %Y"
          },
          {
            "field": "product",
            "title": "Product",
            "type": "nominal"
          },
          {
            "field": "volume_t",
            "title": "Volume (tonnes)",
            "format": ",.0f",
            "type": "quantitative"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
