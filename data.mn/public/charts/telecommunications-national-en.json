{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia main telecommunications infrastructure indicators, 1940–1992 (selected indicators in thousands of pieces).",
  "data": {
    "url": "/datasets/telecommunications-national-en.csv",
    "format": { "type": "csv" }
  },
  "transform": [
    {
      "filter": {
        "field": "unit",
        "oneOf": ["thousands"]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": { "grid": false, "format": "d" }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Thousands of units",
      "axis": { "format": ",.1f" }
    },
    "color": {
      "field": "indicator",
      "type": "nominal",
      "title": "Indicator",
      "scale": {
        "domain": ["Telephone points", "Radio points", "Receivers", "Televisions"],
        "range": ["#3b82f6", "#f59e0b", "#10b981", "#ef4444"]
      },
      "legend": { "orient": "top" }
    }
  },
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 1.5, "interpolate": "monotone", "opacity": 0.85 }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout",
            "fields": ["year"]
          }
        }
      ],
      "mark": { "type": "point", "filled": true, "size": 40 },
      "encoding": {
        "opacity": {
          "condition": { "param": "hover", "empty": false, "value": 1 },
          "value": 0
        },
        "tooltip": [
          { "field": "year", "type": "quantitative", "title": "Year", "format": "d" },
          { "field": "indicator", "type": "nominal", "title": "Indicator" },
          { "field": "value", "type": "quantitative", "title": "Thousands of units", "format": ",.1f" }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": { "stroke": "transparent" },
    "legend": { "labelFontSize": 13, "titleFontSize": 14 }
  }
}
