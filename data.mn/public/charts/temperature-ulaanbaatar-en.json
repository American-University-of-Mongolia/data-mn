{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ulaanbaatar monthly average air temperature (2005-2026)",
  "data": {
    "url": "/datasets/temperature-ulaanbaatar-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "toDate(datum.month + '-01')", "as": "date"}
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Date",
      "axis": {
        "format": "%Y",
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "temperature",
      "type": "quantitative",
      "title": "Temperature (°C)",
      "axis": {
        "format": ".1f",
        "grid": true,
        "gridOpacity": 0.3
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"strokeWidth": 2, "stroke": "#1f77b4"},
        "interpolate": "monotone",
        "color": {
          "x1": 1, "y1": 1, "x2": 1, "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(31, 119, 180, 0.02)"},
            {"offset": 1, "color": "rgba(31, 119, 180, 0.35)"}
          ]
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "month", "title": "Month"},
          {"field": "temperature", "title": "Temperature (°C)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    }
  }
}
