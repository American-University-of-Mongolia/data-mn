---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, type Language } from '~/i18n';

export const prerender = true;

export const getStaticPaths = () => {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'mn' } },
  ];
};

const { lang } = Astro.params;
const currentLang = (lang as Language) || 'mn';
const t = useTranslations(currentLang);

// Get all content from all collections at build time, filtered by language
const dataPages = await getCollection('data', ({ id, data }) =>
  id.startsWith(`${currentLang}/`) && data.draft !== true
);
const reports = await getCollection('reports', ({ id, data }) =>
  id.startsWith(`${currentLang}/`) && data.draft !== true
);
const insights = await getCollection('insights', ({ id, data }) =>
  id.startsWith(`${currentLang}/`) && data.draft !== true
);

// Helper to extract slug from ID
const getSlug = (id: string) => id.replace(/^(en|mn)\//, '').replace(/\.mdx?$/, '');

// Prepare searchable content index for client-side search
const searchIndex = [
  ...dataPages.map((item) => ({
    type: 'data',
    title: item.data.title,
    excerpt: item.data.excerpt || '',
    url: `/${currentLang}/data/${getSlug(item.id)}`,
    publishDate: item.data.publishDate?.toISOString() || '',
    category: item.data.category || '',
    tags: item.data.tags || [],
    keywords: item.data.keywords || [],
    image: item.data.image || '',
  })),
  ...reports.map((item) => ({
    type: 'reports',
    title: item.data.title,
    excerpt: item.data.excerpt || '',
    url: `/${currentLang}/reports/${getSlug(item.id)}`,
    publishDate: item.data.publishDate?.toISOString() || '',
    category: item.data.category || '',
    tags: item.data.tags || [],
    keywords: item.data.keywords || [],
    image: item.data.image || '',
  })),
  ...insights.map((item) => ({
    type: 'insights',
    title: item.data.title,
    excerpt: item.data.excerpt || '',
    url: `/${currentLang}/insights/${getSlug(item.id)}`,
    publishDate: item.data.publishDate?.toISOString() || '',
    category: item.data.category || '',
    tags: item.data.tags || [],
    keywords: item.data.keywords || [],
    image: item.data.image || '',
  })),
];

const metadata = {
  title: t('search.title'),
  description: t('site.description'),
  robots: {
    index: false,
    follow: true,
  },
};

const typeColors: Record<string, string> = {
  data: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  reports: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  insights: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
};

// Translated type labels
const typeLabels: Record<string, string> = {
  data: t('type.data'),
  reports: t('type.report'),
  insights: t('type.insight'),
};

// UI translations for client-side use
const uiTranslations = {
  results: t('search.results'),
  noResults: t('search.noResults'),
  tryDifferent: t('search.tryDifferent'),
  dataLabel: t('nav.data'),
  reportsLabel: t('nav.reports'),
  insightsLabel: t('nav.insights'),
  dataUrl: `/${currentLang}/data`,
  reportsUrl: `/${currentLang}/reports`,
  insightsUrl: `/${currentLang}/insights`,
  locale: currentLang === 'mn' ? 'mn-MN' : 'en-US',
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <div class="mb-12">
      <h1 class="text-4xl font-bold mb-6 text-gray-900 dark:text-gray-100">{t('search.title')}</h1>

      <form id="search-form" class="relative">
        <input
          type="search"
          id="search-input"
          name="q"
          placeholder={t('search.placeholder')}
          class="w-full px-6 py-4 pr-12 text-lg border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary"
          autofocus
        />
        <button
          type="submit"
          class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-primary"
        >
          <Icon name="tabler:search" class="w-6 h-6" />
        </button>
      </form>
    </div>

    <div id="search-results"></div>

    <div id="no-query" class="text-center py-12">
      <Icon name="tabler:search" class="w-16 h-16 mx-auto mb-4 text-gray-400" />
      <p class="text-xl text-gray-600 dark:text-gray-400">{t('search.tryDifferent')}</p>
    </div>
  </section>

  <script define:vars={{ searchIndex, typeColors, typeLabels, uiTranslations, currentLang }}>
    // =======================================================================
    // MONGOLIAN SEARCH: Latin to Cyrillic Transliteration System
    // =======================================================================
    // This enables users to search using Latin characters and find Cyrillic content.
    // Uses a two-tier approach:
    // 1. Word/phrase mappings for known terms (including English translations)
    // 2. Character-level transliteration fallback for unknown words

    // Word and phrase mappings (includes stems, full words, and English translations)
    const wordMap = {
      // === Multi-word phrases (checked first due to length sorting) ===
      'hun am': 'хүн ам',
      'hunam': 'хүн ам',
      'ediin zasag': 'эдийн засаг',
      'eruul mend': 'эрүүл мэнд',
      'erchim huch': 'эрчим хүч',
      'mal aj ahui': 'мал аж ахуй',
      'ayalal juulchlal': 'аялал жуулчлал',
      'nasni butets': 'насны бүтэц',

      // === Single word stems (romanized Mongolian) ===
      'mongol': 'монгол',
      'hun': 'хүн',
      'am': 'ам',
      'ediin': 'эдийн',
      'zasag': 'засаг',
      'eruul': 'эрүүл',
      'mend': 'мэнд',
      'bolovsrol': 'боловсрол',
      'ajilguidel': 'ажилгүйдэл',
      'ajil': 'ажил',
      'hudaldaa': 'худалдаа',
      'tsalin': 'цалин',
      'mal': 'мал',
      'inflyatsi': 'инфляци',
      'uilchilgee': 'үйлчилгээ',
      'ayalal': 'аялал',
      'erchim': 'эрчим',
      'huch': 'хүч',
      'pyramid': 'пирамид',
      'piramid': 'пирамид',
      'huis': 'хүйс',
      'eregtei': 'эрэгтэй',
      'emegtei': 'эмэгтэй',
      'nas': 'нас',
      'nasni': 'насны',
      'butets': 'бүтэц',
      'toollogo': 'тооллого',
      'orlogo': 'орлого',
      'orts': 'өрх',
      'orokh': 'өрх',
      'uls': 'улс',
      'niit': 'нийт',
      'osolт': 'өсөлт',

      // === English concept translations ===
      'population': 'хүн ам',
      'demographic': 'хүн ам',
      'demographics': 'хүн ам',
      'economy': 'эдийн засаг',
      'economic': 'эдийн засаг',
      'gdp': 'ДНБ',
      'education': 'боловсрол',
      'unemployment': 'ажилгүйдэл',
      'employment': 'ажил',
      'job': 'ажил',
      'jobs': 'ажил',
      'healthcare': 'эрүүл мэнд',
      'health': 'эрүүл мэнд',
      'medical': 'эрүүл мэнд',
      'trade': 'худалдаа',
      'commerce': 'худалдаа',
      'salary': 'цалин',
      'wage': 'цалин',
      'wages': 'цалин',
      'income': 'орлого',
      'livestock': 'мал',
      'cattle': 'мал',
      'herding': 'мал',
      'inflation': 'инфляци',
      'price': 'үнэ',
      'prices': 'үнэ',
      'service': 'үйлчилгээ',
      'services': 'үйлчилгээ',
      'tourism': 'аялал жуулчлал',
      'travel': 'аялал',
      'energy': 'эрчим хүч',
      'power': 'эрчим хүч',
      'electricity': 'эрчим хүч',
      'sex': 'хүйс',
      'gender': 'хүйс',
      'male': 'эрэгтэй',
      'female': 'эмэгтэй',
      'men': 'эрэгтэй',
      'women': 'эмэгтэй',
      'age': 'нас',
      'census': 'тооллого',
      'count': 'тоо',
      'household': 'өрх',
      'family': 'өрх',
      'total': 'нийт',
      'growth': 'өсөлт',
      'mongolia': 'монгол',
      'mongolian': 'монгол',
    };

    // Character-level Latin to Cyrillic mapping (fallback for unknown words)
    // Based on common Mongolian romanization patterns
    const charMap = {
      // Digraphs (must be processed before single chars)
      'kh': 'х', 'ts': 'ц', 'ch': 'ч', 'sh': 'ш', 'zh': 'ж',
      'yo': 'ё', 'yu': 'ю', 'ya': 'я', 'ye': 'е',
      // Single characters
      'a': 'а', 'b': 'б', 'v': 'в', 'g': 'г', 'd': 'д',
      'e': 'э', 'z': 'з', 'i': 'и', 'j': 'ж', 'k': 'к',
      'l': 'л', 'm': 'м', 'n': 'н', 'o': 'о', 'p': 'п',
      'r': 'р', 's': 'с', 't': 'т', 'u': 'ү', 'f': 'ф',
      'h': 'х', 'c': 'ц', 'y': 'й', 'w': 'в',
    };

    // Transliterate a single word using character mapping
    function transliterateChars(word) {
      let result = word.toLowerCase();
      // Process digraphs first (longer patterns)
      const digraphs = ['kh', 'ts', 'ch', 'sh', 'zh', 'yo', 'yu', 'ya', 'ye'];
      for (const di of digraphs) {
        result = result.split(di).join(charMap[di] || di);
      }
      // Then single characters
      result = result.split('').map(c => charMap[c] || c).join('');
      return result;
    }

    // Main transliteration function - converts Latin query to Cyrillic
    function transliterate(query) {
      if (currentLang !== 'mn') return { result: query, changed: false };
      if (!hasLatinChars(query)) return { result: query, changed: false };

      let result = query.toLowerCase();
      let changed = false;

      // Step 1: Apply word-level mappings (longest phrases first)
      const sortedKeys = Object.keys(wordMap).sort((a, b) => b.length - a.length);
      for (const key of sortedKeys) {
        const regex = new RegExp(`\\b${key}\\b`, 'gi');
        const newResult = result.replace(regex, wordMap[key]);
        if (newResult !== result) {
          result = newResult;
          changed = true;
        }
      }

      // Step 2: For any remaining Latin words, apply character-level transliteration
      if (hasLatinChars(result)) {
        // Split by spaces, transliterate Latin words, rejoin
        result = result.split(/\s+/).map(word => {
          if (hasLatinChars(word)) {
            const transliterated = transliterateChars(word);
            if (transliterated !== word) changed = true;
            return transliterated;
          }
          return word;
        }).join(' ');
      }

      return { result, changed };
    }

    // Check if string contains Latin characters
    function hasLatinChars(str) {
      return /[a-zA-Z]/.test(str);
    }

    // Check if an item matches a single keyword
    function itemMatchesKeyword(item, keyword) {
      const lowerKeyword = keyword.toLowerCase();
      if (item.title.toLowerCase().includes(lowerKeyword)) return true;
      if (item.excerpt.toLowerCase().includes(lowerKeyword)) return true;
      if (item.keywords.some((kw) => kw.toLowerCase().includes(lowerKeyword))) return true;
      if (item.tags.some((tag) => tag.toLowerCase().includes(lowerKeyword))) return true;
      if (item.category.toLowerCase().includes(lowerKeyword)) return true;
      return false;
    }

    // Check if an item matches ANY of the keywords (for more lenient search)
    function itemMatchesAnyKeyword(item, keywords) {
      return keywords.some((kw) => itemMatchesKeyword(item, kw));
    }

    // Check if an item matches ALL keywords
    function itemMatchesAllKeywords(item, keywords) {
      return keywords.every((kw) => itemMatchesKeyword(item, kw));
    }

    // Score an item based on how many keywords it matches (for ranking)
    function scoreItem(item, keywords) {
      let score = 0;
      for (const kw of keywords) {
        if (itemMatchesKeyword(item, kw)) score++;
        // Bonus for title matches
        if (item.title.toLowerCase().includes(kw.toLowerCase())) score += 2;
      }
      return score;
    }

    // =======================================================================
    // MULTI-STRATEGY SEARCH
    // =======================================================================
    // 1. Try transliterated query (for Mongolian content)
    // 2. Try original query (for English content or already-Cyrillic)
    // 3. Progressive relaxation: require fewer keywords if no results
    // 4. Rank results by relevance score

    function searchContent(query) {
      const originalQuery = query.trim();
      if (!originalQuery) return { results: [], displayQuery: '' };

      const lowerQuery = originalQuery.toLowerCase();

      // Get transliterated version for Mongolian search
      const { result: transliteratedQuery, changed: wasTransliterated } = transliterate(lowerQuery);

      // Prepare keyword sets
      const originalKeywords = lowerQuery.split(/\s+/).filter(Boolean);
      const transliteratedKeywords = transliteratedQuery.split(/\s+/).filter(Boolean);

      // Combine unique keywords from both (for dual search)
      const allKeywords = [...new Set([...originalKeywords, ...transliteratedKeywords])];

      let results = [];

      // Strategy 1: Try matching ALL transliterated keywords
      if (wasTransliterated) {
        results = searchIndex.filter(item => itemMatchesAllKeywords(item, transliteratedKeywords));
      }

      // Strategy 2: If no results, try ALL original keywords
      if (results.length === 0) {
        results = searchIndex.filter(item => itemMatchesAllKeywords(item, originalKeywords));
      }

      // Strategy 3: If still no results, try ANY keyword (more lenient)
      if (results.length === 0 && allKeywords.length > 1) {
        results = searchIndex.filter(item => itemMatchesAnyKeyword(item, allKeywords));
      }

      // Strategy 4: If still no results, try each keyword individually
      if (results.length === 0) {
        for (const kw of allKeywords) {
          const kwResults = searchIndex.filter(item => itemMatchesKeyword(item, kw));
          if (kwResults.length > 0) {
            results = kwResults;
            break;
          }
        }
      }

      // Rank results by relevance score
      if (results.length > 1) {
        results = results.map(item => ({
          ...item,
          _score: scoreItem(item, allKeywords)
        })).sort((a, b) => b._score - a._score);
      }

      return {
        results,
        displayQuery: originalQuery, // Always show what user typed
        matchedWith: wasTransliterated ? transliteratedQuery : null,
        totalKeywords: allKeywords.length,
      };
    }

    function formatDate(dateString) {
      if (!dateString) return '';
      const date = new Date(dateString);
      return date.toLocaleDateString(uiTranslations.locale, {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    }

    function renderResults(searchResult, originalQuery) {
      const resultsContainer = document.getElementById('search-results');
      const noQueryDiv = document.getElementById('no-query');
      const { results, displayQuery } = searchResult;

      if (!originalQuery) {
        resultsContainer.innerHTML = '';
        noQueryDiv.style.display = 'block';
        return;
      }

      noQueryDiv.style.display = 'none';

      if (results.length === 0) {
        resultsContainer.innerHTML = `
          <div class="text-center py-12">
            <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <p class="text-xl text-gray-600 dark:text-gray-400 mb-2">${uiTranslations.noResults}</p>
            <p class="text-gray-500 dark:text-gray-500">${uiTranslations.tryDifferent}</p>
            <div class="flex justify-center gap-4 mt-6">
              <a href="${uiTranslations.dataUrl}" class="text-primary hover:underline">${uiTranslations.dataLabel}</a>
              <a href="${uiTranslations.reportsUrl}" class="text-primary hover:underline">${uiTranslations.reportsLabel}</a>
              <a href="${uiTranslations.insightsUrl}" class="text-primary hover:underline">${uiTranslations.insightsLabel}</a>
            </div>
          </div>
        `;
        return;
      }

      const resultsHTML = `
        <div class="mb-6">
          <p class="text-gray-600 dark:text-gray-400">
            <span class="font-semibold text-gray-900 dark:text-gray-100">${results.length}</span>
            ${uiTranslations.results}:
            <span class="font-semibold text-gray-900 dark:text-gray-100">"${displayQuery}"</span>
          </p>
        </div>
        <div class="space-y-6">
          ${results
            .map(
              (result) => `
            <article class="p-6 bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 hover:border-primary dark:hover:border-primary transition-colors">
              <div class="mb-2">
                <span class="inline-block px-2 py-1 text-xs font-semibold rounded ${typeColors[result.type]}">
                  ${typeLabels[result.type]}
                </span>
                ${result.category ? `<span class="ml-2 text-sm text-gray-500 dark:text-gray-400">${result.category}</span>` : ''}
              </div>
              <h2 class="text-2xl font-bold mb-2">
                <a href="${result.url}" class="text-gray-900 dark:text-gray-100 hover:text-primary dark:hover:text-primary">
                  ${result.title}
                </a>
              </h2>
              ${result.excerpt ? `<p class="text-gray-600 dark:text-gray-400 mb-3">${result.excerpt}</p>` : ''}
              <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
                ${result.publishDate ? `<time datetime="${result.publishDate}">${formatDate(result.publishDate)}</time>` : ''}
                ${
                  result.tags.length > 0
                    ? `
                  <div class="flex flex-wrap gap-2">
                    ${result.tags
                      .slice(0, 3)
                      .map((tag) => `<span class="px-2 py-1 text-xs bg-gray-100 dark:bg-slate-700 rounded">${tag}</span>`)
                      .join('')}
                  </div>
                `
                    : ''
                }
              </div>
            </article>
          `
            )
            .join('')}
        </div>
      `;

      resultsContainer.innerHTML = resultsHTML;
    }

    function performSearch() {
      const urlParams = new URLSearchParams(window.location.search);
      const query = urlParams.get('q') || '';
      const searchInput = document.getElementById('search-input');

      searchInput.value = query;

      if (query) {
        const searchResult = searchContent(query);
        renderResults(searchResult, query);
      } else {
        renderResults({ results: [], usedQuery: '' }, '');
      }
    }

    // Initialize search functionality
    function initSearch() {
      performSearch();

      // Handle form submission
      const form = document.getElementById('search-form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const query = document.getElementById('search-input').value;
          const url = new URL(window.location.href);
          url.searchParams.set('q', query);
          window.history.pushState({}, '', url);
          performSearch();
        });
      }
    }

    // Run on initial page load
    initSearch();

    // Re-run when navigating with View Transitions
    document.addEventListener('astro:page-load', initSearch);

    // Handle browser back/forward
    window.addEventListener('popstate', performSearch);
  </script>
</Layout>
