{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia newly issued bank loans monthly flow",
  "data": {
    "url": "/datasets/mongolbank-new-issued-loans-en.csv",
    "format": { "type": "csv" }
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Date",
      "axis": { "grid": false, "labelAngle": -45 }
    },
    "y": {
      "field": "new_loans_issued_billion_mnt",
      "type": "quantitative",
      "title": "Newly Issued Loans (MNT billion)",
      "scale": { "zero": true },
      "axis": { "format": ",.0f", "grid": true, "gridOpacity": 0.3 }
    }
  },
  "layer": [
    {
      "mark": { "type": "bar", "color": "#6366f1", "opacity": 0.8 }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": { "type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout" }
        }
      ],
      "mark": { "type": "point", "filled": true, "color": "#6366f1", "size": 0 },
      "encoding": {
        "opacity": { "value": 0 },
        "tooltip": [
          { "field": "date", "type": "temporal", "title": "Date", "format": "%Y-%m" },
          { "field": "new_loans_issued_billion_mnt", "type": "quantitative", "title": "New Loans (MNT billion)", "format": ",.1f" }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": "transparent" },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": { "labelFontSize": 13, "titleFontSize": 14 }
  }
}
