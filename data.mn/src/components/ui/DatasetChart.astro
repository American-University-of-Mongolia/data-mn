---
import VegaChart from './VegaChart.astro';

interface Props {
  spec: string | object;
  title: string;
  caption: string;
  aspectRatio?: number;
  /** Use theme colours for neutral text annotations, never colour-coded labels. */
  themeText?: boolean;
  legend?: { domain: string[]; range: string[] };
}
const { spec, title, caption, aspectRatio = 0.65, themeText = false, legend } = Astro.props;
if (legend && legend.domain.length !== legend.range.length) {
  throw new Error('DatasetChart legend domain and colour range must match');
}
---

<div class:list={['dataset-chart', { 'theme-text': themeText }]}>
  <VegaChart {spec} {title} {caption} {aspectRatio} />
  {
    legend && (
      <ul class="dataset-legend not-prose">
        {legend.domain.map((label, index) => (
          <li>
            <span class="swatch" style={{ backgroundColor: legend.range[index] }} aria-hidden="true" />
            <span>{label}</span>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  /* Shared presentation of Vega's native controls. The shared component
     owns rendering, cleanup, and selection persistence through theme changes. */
  .dataset-chart :global(.vega-embed),
  .dataset-chart :global(.chart-wrapper) {
    display: flex !important;
    flex-direction: column;
  }
  .dataset-chart :global(.vega-bindings) {
    order: -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.5rem 0 1.25rem;
    width: 100%;
  }
  .dataset-chart :global(.vega-bind) {
    flex: 1 1 10rem;
    min-width: 0;
  }
  .dataset-chart :global(.vega-bind label) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.5rem;
    background: white;
    color: #64748b;
    font-size: 0.75rem;
  }
  .dataset-chart :global(.vega-bind select) {
    width: 100%;
    min-width: 0;
    border: 0;
    padding: 0.15rem 1.5rem 0.15rem 0;
    background-color: transparent;
    color: #334155;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .dataset-chart :global(.vega-bind select:focus-visible) {
    outline: 2px solid #2563eb;
    outline-offset: 3px;
    border-radius: 0.2rem;
  }
  :global(.dark) .dataset-chart :global(.vega-bind label) {
    background: #1e293b;
    border-color: #475569;
    color: #cbd5e1;
  }
  :global(.dark) .dataset-chart :global(.vega-bind select) {
    color: #e2e8f0;
    color-scheme: dark;
  }
  :global(.dark) .theme-text :global(.mark-text text) {
    fill: #e2e8f0;
  }
  .dataset-legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem 1.25rem;
    padding: 0;
    margin: 1rem 0 1.5rem;
    list-style: none;
    color: #475569;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .dataset-legend li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
  }
  .swatch {
    flex: 0 0 0.8rem;
    height: 0.8rem;
    margin-top: 0.2rem;
    border-radius: 0.15rem;
  }
  :global(.dark) .dataset-legend {
    color: #cbd5e1;
  }
  @media (max-width: 440px) {
    .dataset-legend {
      grid-template-columns: 1fr;
    }
  }
</style>
