{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын ам.долларын сарын дундаж ханш (МНТ), 1993-2026",
  "data": {
    "url": "/datasets/mongolbank-usd-mnt-monthly-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "Огноо",
      "type": "temporal",
      "title": "Огноо",
      "axis": {
        "grid": false,
        "labelAngle": -45,
        "format": "%Y"
      }
    },
    "y": {
      "field": "Ханш (₮)",
      "type": "quantitative",
      "title": "АНУ доллар/Төгрөг ханш",
      "axis": {
        "format": ",.0f",
        "grid": true,
        "gridOpacity": 0.3
      },
      "scale": {
        "zero": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "color": "#2563eb",
          "strokeWidth": 2
        },
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "white"},
            {"offset": 1, "color": "#2563eb"}
          ]
        },
        "interpolate": "monotone",
        "opacity": 0.2
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60,
        "color": "#2563eb"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "Огноо",
            "type": "temporal",
            "title": "Сар",
            "format": "%Y-%m"
          },
          {
            "field": "Ханш (₮)",
            "type": "quantitative",
            "title": "АНУ доллар/₮",
            "format": ",.2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
