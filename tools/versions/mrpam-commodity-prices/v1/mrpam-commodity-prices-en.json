{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly world-market prices for five mineral commodities quoted in USD per tonne.",
  "data": {
    "url": "/datasets/mrpam-commodity-prices-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"}
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Date",
      "axis": {"format": "%b %Y", "grid": false, "labelAngle": -30}
    },
    "y": {
      "field": "price",
      "type": "quantitative",
      "title": "Price (USD per tonne)",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "commodity",
      "type": "nominal",
      "title": "Commodity",
      "scale": {
        "domain": ["Copper", "Zinc", "Lead", "Tin", "Molybdenum"],
        "range": ["#4c78a8", "#f58518", "#e45756", "#72b7b2", "#54a24b"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"}},
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Date", "format": "%B %Y"},
          {"field": "commodity", "type": "nominal", "title": "Commodity"},
          {"field": "price", "type": "quantitative", "title": "Price (USD/tonne)", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
