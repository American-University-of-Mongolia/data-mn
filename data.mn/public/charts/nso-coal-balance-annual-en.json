{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia coal balance by indicator (thousand tonnes), 1989–2024",
  "data": {
    "url": "/datasets/nso-coal-balance-annual-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "datetime(datum.year, 0, 1)", "as": "date"}
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Year",
      "axis": {"format": "%Y", "grid": false, "labelAngle": -30}
    },
    "y": {
      "field": "kt",
      "type": "quantitative",
      "title": "Thousand tonnes",
      "axis": {"format": ","}
    },
    "color": {
      "field": "indicator",
      "type": "nominal",
      "title": "Indicator",
      "scale": {
        "domain": ["Produced", "Export", "Consumption (total)", "Consumed by thermal power stations", "Distributed to establishments and households for fuel purposes", "Imports", "Losses during transportation and storage"],
        "range": ["#1e40af", "#ef4444", "#f59e0b", "#10b981", "#8b5cf6", "#06b6d4", "#94a3b8"]
      },
      "legend": {"orient": "top", "columns": 2}
    }
  },
  "layer": [
    {"mark": {"type": "line", "interpolate": "monotone", "strokeWidth": 2}},
    {
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "pointerover", "nearest": true, "clear": "pointerout"}
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 50},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "indicator", "type": "nominal", "title": "Indicator"},
          {"field": "kt", "type": "quantitative", "title": "Thousand tonnes", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelLimit": 350
    },
    "view": {"stroke": "transparent"}
  }
}
