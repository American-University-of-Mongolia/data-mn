{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia monthly weighted average FX deposit interest rate (outstanding deposits), 2008-2026",
  "data": {
    "url": "/datasets/mongolbank-deposit-rate-fx-monthly-en.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": "Date",
      "axis": {
        "grid": false,
        "labelAngle": -45,
        "format": "%Y"
      }
    },
    "y": {
      "field": "Rate (%)",
      "type": "quantitative",
      "title": "FX Deposit Rate (%)",
      "axis": {
        "format": ".1f",
        "grid": true,
        "gridOpacity": 0.3
      },
      "scale": {
        "zero": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "color": "#10b981",
          "strokeWidth": 2
        },
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "white"},
            {"offset": 1, "color": "#10b981"}
          ]
        },
        "interpolate": "monotone",
        "opacity": 0.2
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60,
        "color": "#10b981"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "Date",
            "type": "temporal",
            "title": "Month",
            "format": "%b %Y"
          },
          {
            "field": "Rate (%)",
            "type": "quantitative",
            "title": "FX Deposit Rate (%)",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
