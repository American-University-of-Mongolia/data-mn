{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia average monthly wages by economic activity (2001-2025), featured sectors, Total sex",
  "data": {
    "url": "/datasets/nso-wages-by-economic-activity-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {"format": "d", "tickMinStep": 5, "grid": false}
    },
    "y": {
      "field": "wages_mnt",
      "type": "quantitative",
      "title": "Monthly Wages, Thousand MNT (nominal)",
      "axis": {"format": ".0f"},
      "scale": {"zero": true}
    },
    "color": {
      "field": "sector",
      "type": "nominal",
      "title": "Economic Activity",
      "scale": {
        "domain": [
          "National average",
          "Mining and quarrying",
          "Financial and insurance activities",
          "Manufacturing",
          "Agriculture, forestry, fishing and hunting",
          "Public administration and defense; compulsory social security"
        ],
        "range": ["#4c78a8", "#f58518", "#e45756", "#72b7b2", "#54a24b", "#eeca3b"]
      },
      "legend": {"orient": "top", "columns": 2, "title": null}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"}
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "year", "title": "Year", "format": "d"},
          {"field": "sector", "title": "Sector"},
          {"field": "wages_mnt", "title": "Wages (Thousand MNT)", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
