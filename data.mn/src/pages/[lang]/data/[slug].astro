---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, formatDate, type Language } from '~/i18n';

export const prerender = true;

export const getStaticPaths = (async () => {
  const dataPages = await getCollection('data', ({ data }) => {
    return data.draft !== true;
  });

  return dataPages.map((page) => {
    const [lang, ...slugParts] = page.id.split('/');
    const slug = slugParts.join('/').replace(/\.mdx?$/, '');

    return {
      params: { lang, slug },
      props: { page },
    };
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { lang } = Astro.params;
const currentLang = (lang as Language) || 'en';
const t = useTranslations(currentLang);

const { Content } = await render(page);

const { title, excerpt, publishDate, updateDate, author, category, tags, dataFiles, dataVersion, dataDate, source } = page.data;

const metadata = {
  title: title,
  description: excerpt,
  ...page.data.metadata,
};

// Labels
const labels = {
  download: currentLang === 'en' ? 'Download' : 'Татах',
  source: currentLang === 'en' ? 'Source' : 'Эх сурвалж',
  published: currentLang === 'en' ? 'Published' : 'Нийтэлсэн',
  updated: currentLang === 'en' ? 'Updated' : 'Шинэчилсэн',
  version: currentLang === 'en' ? 'Version' : 'Хувилбар',
  by: currentLang === 'en' ? 'by' : '',
};
---

<Layout metadata={metadata}>
  <article class="px-4 sm:px-6 py-6 sm:py-8 mx-auto max-w-5xl">
    <!-- Compact Header -->
    <header class="mb-4">
      <!-- Breadcrumb -->
      <nav class="text-sm mb-2">
        <a href={`/${currentLang}/data`} class="text-primary hover:underline">{t('nav.data')}</a>
        {category && (
          <>
            <span class="text-gray-400 mx-2">›</span>
            <a href={`/${currentLang}/data?category=${category}`} class="text-primary hover:underline">{category}</a>
          </>
        )}
      </nav>

      <!-- Title -->
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100 leading-tight">
        {title}
      </h1>

      <!-- Description below title -->
      <p class="mt-3 text-base text-gray-600 dark:text-gray-400">
        {excerpt}
      </p>
    </header>

    <!-- Main Content: Two Column Layout -->
    <div class="flex flex-col lg:flex-row gap-6">
      <!-- Left: Chart and Description -->
      <div class="flex-1 min-w-0">
        <!-- Chart Container (from MDX) -->
        <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-4">
          <div class="prose prose-sm dark:prose-invert max-w-none [&_.vega-chart-container]:my-0 [&>p]:hidden [&_h3]:hidden [&_.data-download-section]:hidden">
            <Content />
          </div>
        </div>
      </div>

      <!-- Right: Sidebar -->
      <aside class="lg:w-72 flex-shrink-0">
        <div class="bg-gray-50 dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-4 space-y-4 sticky top-4">
          <!-- Download Section -->
          {dataFiles && dataFiles.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">
                {labels.download}
              </h3>
              <div class="flex flex-wrap gap-2">
                {/* Sort files: Excel first, then CSV */}
                {[...dataFiles].sort((a, b) => {
                  const order = { xlsx: 0, xls: 1, csv: 2 };
                  return (order[a.format.toLowerCase()] ?? 99) - (order[b.format.toLowerCase()] ?? 99);
                }).map((file) => {
                  const format = file.format.toLowerCase();
                  const isExcel = format === 'xlsx' || format === 'xls';
                  const iconName = isExcel ? 'tabler:table' : 'tabler:file-text';
                  const label = isExcel ? 'Excel' : 'Text/CSV';
                  return (
                    <a
                      href={file.path}
                      download
                      class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium bg-white dark:bg-slate-700 border border-gray-200 dark:border-slate-600 rounded hover:border-primary hover:text-primary transition-colors"
                    >
                      <Icon name={iconName} class="w-4 h-4" />
                      {label}
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Source -->
          {source && (
            <div>
              <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                {labels.source}
              </h3>
              <a href={source.url} target="_blank" rel="noopener" class="text-sm text-primary hover:underline">
                {source.name}
              </a>
              {source.tableId && (
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 font-mono">
                  {source.tableId}
                </p>
              )}
            </div>
          )}

          <!-- Published Date -->
          {publishDate && (
            <div>
              <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                {labels.published}
              </h3>
              <p class="text-sm text-gray-700 dark:text-gray-300">
                {publishDate.toISOString().split('T')[0].replace(/-/g, '/')}
              </p>
            </div>
          )}


          <!-- Tags (with divider line instead of label) -->
          {tags && tags.length > 0 && (
            <div class="pt-3 border-t border-gray-200 dark:border-slate-600">
              <div class="flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <a
                    href={`/${currentLang}/data?tag=${tag}`}
                    class="px-2 py-1 text-xs bg-white dark:bg-slate-700 border border-gray-200 dark:border-slate-600 text-gray-600 dark:text-gray-400 rounded hover:border-primary hover:text-primary transition-colors"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </article>
</Layout>
