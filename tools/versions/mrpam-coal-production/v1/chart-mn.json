{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын нүүрсний сарын олборлолт, борлуулалт, экспорт, мянган тонноор.",
  "data": {
    "url": "/datasets/mrpam-coal-production-mn.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "datetime(datum['он'], datum['сар'] - 1, 1)", "as": "огноо"},
    {
      "fold": ["олборлолт_мян_тн", "борлуулалт_мян_тн", "экспорт_мян_тн"],
      "as": ["үзүүлэлт", "утга"]
    },
    {
      "calculate": "datum['үзүүлэлт'] === 'олборлолт_мян_тн' ? 'Олборлолт' : datum['үзүүлэлт'] === 'борлуулалт_мян_тн' ? 'Борлуулалт' : 'Экспорт'",
      "as": "хэмжүүр"
    }
  ],
  "encoding": {
    "x": {
      "field": "огноо",
      "type": "temporal",
      "title": "Сар",
      "axis": {"format": "%Y-%m", "labelAngle": -45, "grid": false}
    },
    "y": {
      "field": "утга",
      "type": "quantitative",
      "title": "Мянган тонн",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "хэмжүүр",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Олборлолт", "Борлуулалт", "Экспорт"],
        "range": ["#4c78a8", "#f58518", "#72b7b2"]
      },
      "legend": {"orient": "top"}
    }
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 2.5}},
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["огноо"],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "огноо", "type": "temporal", "title": "Сар", "format": "%Y-%m"},
          {"field": "хэмжүүр", "type": "nominal", "title": "Үзүүлэлт"},
          {"field": "утга", "type": "quantitative", "title": "Мянган тонн", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
