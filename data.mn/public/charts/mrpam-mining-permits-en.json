{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "National monthly exploration and extraction permit counts in Mongolia.",
  "data": {
    "format": {
      "type": "csv"
    },
    "url": "/datasets/mrpam-mining-permits-en.csv"
  },
  "encoding": {
    "color": {
      "field": "metric",
      "legend": {
        "orient": "top"
      },
      "scale": {
        "domain": [
          "Exploration",
          "Extraction"
        ],
        "range": [
          "#4c78a8",
          "#f58518"
        ]
      },
      "title": null,
      "type": "nominal"
    },
    "x": {
      "axis": {
        "format": "%Y",
        "grid": false
      },
      "field": "month",
      "title": "Month",
      "type": "temporal"
    },
    "y": {
      "axis": {
        "format": ",.0f"
      },
      "field": "value",
      "scale": {
        "zero": true
      },
      "title": "Permit count",
      "type": "quantitative"
    }
  },
  "layer": [
    {
      "mark": {
        "strokeWidth": 2.5,
        "type": "line"
      }
    },
    {
      "encoding": {
        "opacity": {
          "condition": {
            "empty": false,
            "param": "hover",
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "month",
            "format": "%B %Y",
            "title": "Month",
            "type": "temporal"
          },
          {
            "field": "metric",
            "title": "Permit type",
            "type": "nominal"
          },
          {
            "field": "value",
            "format": ",.0f",
            "title": "Count",
            "type": "quantitative"
          }
        ]
      },
      "mark": {
        "filled": true,
        "size": 80,
        "type": "point"
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "clear": "pointerout",
            "nearest": true,
            "on": "pointerover",
            "type": "point"
          }
        }
      ]
    }
  ],
  "config": {
    "axis": {
      "labelColor": "#64748b",
      "labelFontSize": 14,
      "titleColor": "#334155",
      "titleFontSize": 16
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
