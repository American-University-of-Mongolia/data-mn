---
import { Icon } from 'astro-icon/components';
import type { Brands as Props } from '~/types';

import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
const {
  title = '',
  subtitle = '',
  tagline = '',
  icons = [],
  images = [],
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div class="flex flex-wrap justify-center items-center gap-x-8 sm:gap-x-12 lg:gap-x-16 gap-y-6">
    {icons && icons.map((icon) => <Icon name={icon} class="py-3 lg:py-5 w-12 h-auto mx-auto sm:mx-0 text-gray-500" />)}
    {
      images &&
        images.map(
          (image) =>
            image.src && (
              <div class="flex justify-center items-center py-2 px-3">
                {image.href ? (
                  <a href={image.href} target="_blank" rel="noopener noreferrer" class="hover:opacity-100 transition-opacity">
                    <img
                      src={typeof image.src === 'string' ? image.src : image.src.src}
                      alt={image.alt || ''}
                      class={`object-contain opacity-70 grayscale hover:opacity-90 transition-opacity ${image.tall ? 'h-12 sm:h-16 w-auto' : 'h-6 sm:h-8 w-auto'}`}
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <img
                    src={typeof image.src === 'string' ? image.src : image.src.src}
                    alt={image.alt || ''}
                    class={`object-contain opacity-70 grayscale ${image.tall ? 'h-12 sm:h-16 w-auto' : 'h-6 sm:h-8 w-auto'}`}
                    loading="lazy"
                  />
                )}
              </div>
            )
        )
    }
  </div>
</WidgetWrapper>
