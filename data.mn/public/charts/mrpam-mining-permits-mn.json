{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын хайгуулын болон ашиглалтын тусгай зөвшөөрлийн сарын тоо.",
  "data": {
    "url": "/datasets/mrpam-mining-permits-mn.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "datetime(datum['он'], datum['сар'] - 1, 1)", "as": "огноо"},
    {"fold": ["хайгуулын_тоо", "ашиглалтын_тоо"], "as": ["үзүүлэлт", "тоо"]},
    {
      "calculate": "datum['үзүүлэлт'] === 'хайгуулын_тоо' ? 'Хайгуулын' : 'Ашиглалтын'",
      "as": "зөвшөөрлийн_төрөл"
    }
  ],
  "encoding": {
    "x": {
      "field": "огноо",
      "type": "temporal",
      "title": "Сар",
      "axis": {"format": "%Y-%m", "labelAngle": -45, "grid": false}
    },
    "y": {
      "field": "тоо",
      "type": "quantitative",
      "title": "Тусгай зөвшөөрлийн тоо",
      "scale": {"zero": true},
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "зөвшөөрлийн_төрөл",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Хайгуулын", "Ашиглалтын"],
        "range": ["#4c78a8", "#f58518"]
      },
      "legend": {"orient": "top"}
    }
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 2.5}},
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["огноо"],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "огноо", "type": "temporal", "title": "Сар", "format": "%Y-%m"},
          {"field": "зөвшөөрлийн_төрөл", "type": "nominal", "title": "Зөвшөөрлийн төрөл"},
          {"field": "тоо", "type": "quantitative", "title": "Тоо", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
