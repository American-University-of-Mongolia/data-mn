{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia monthly coal production, sales, and export in thousand tonnes (2021–2025)",
  "data": {
    "url": "/datasets/mrpam-coal-production-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "datum.year + '-' + (datum.month < 10 ? '0' + datum.month : '' + datum.month) + '-01'",
      "as": "date"
    },
    {
      "fold": ["production_kt", "sales_kt", "export_kt"],
      "as": ["metric", "value"]
    },
    {
      "calculate": "datum.metric === 'production_kt' ? 'Production' : datum.metric === 'sales_kt' ? 'Sales' : 'Export'",
      "as": "metric_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Date",
      "axis": {"format": "%b %Y", "labelAngle": -45, "grid": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Thousand Tonnes",
      "scale": {"zero": true},
      "axis": {"format": ",.0f", "grid": true, "gridOpacity": 0.3}
    },
    "color": {
      "field": "metric_label",
      "type": "nominal",
      "title": "Metric",
      "scale": {
        "domain": ["Production", "Sales", "Export"],
        "range": ["#4c78a8", "#f58518", "#e45756"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"}
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 60},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Date", "format": "%b %Y"},
          {"field": "metric_label", "type": "nominal", "title": "Metric"},
          {"field": "value", "type": "quantitative", "title": "Thousand Tonnes", "format": ",.1f"}
        ]
      }
    }
  ],
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
