{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын нийт тариалсан талбай 1960-2025 оны өгөгдөл (мянгаан га)",
  "data": {
    "url": "/datasets/sown-area-total-mongolia-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "он",
      "type": "quantitative",
      "title": "Он",
      "axis": {
        "format": "d",
        "tickMinStep": 5,
        "grid": false
      }
    },
    "y": {
      "field": "тариалсан_талбай",
      "type": "quantitative",
      "title": "Тариалсан талбай (мянгаан га)",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": ",.0f"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "color": "#4c78a8",
          "strokeWidth": 2.5
        },
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {
              "offset": 0,
              "color": "rgba(76, 120, 168, 0.01)"
            },
            {
              "offset": 1,
              "color": "rgba(76, 120, 168, 0.3)"
            }
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#4c78a8",
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "он",
            "title": "Он",
            "format": "d"
          },
          {
            "field": "тариалсан_талбай",
            "title": "Тариалсан талбай (мянгаан га)",
            "format": ",.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
