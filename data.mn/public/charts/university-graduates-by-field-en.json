{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "University and college graduates in Mongolia by professional field from 2019 to 2024",
  "data": {
    "url": "/datasets/university-graduates-by-field-en.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d",
        "tickMinStep": 1,
        "grid": false
      }
    },
    "y": {
      "field": "graduates",
      "type": "quantitative",
      "title": "Number of Graduates",
      "axis": {
        "format": ",.0f"
      },
      "stack": "zero"
    },
    "color": {
      "field": "field",
      "type": "nominal",
      "title": "Professional Field",
      "scale": {
        "domain": [
          "Business, administration and law",
          "Health and welfare",
          "Education",
          "Engineering, manufacturing and construction",
          "Arts and humanities",
          "Social sciences, journalism and information",
          "Information and Communication Technologies",
          "Services",
          "Natural sciences, mathematics and statistics",
          "Agriculture, forestry, fisheries and veterinary"
        ],
        "range": [
          "#4E79A7",
          "#F28E2B",
          "#E15759",
          "#59A14F",
          "#B07AA1",
          "#76B7B2",
          "#EDC948",
          "#FF9DA7",
          "#9C755F",
          "#BAB0AC"
        ]
      },
      "legend": {
        "orient": "top",
        "values": {
          "expr": "selectedCategories"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "field",
            "title": "Professional Field"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "graduates",
            "title": "Graduates",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  },
  "params": [
    {
      "name": "selectedCategories",
      "value": [
        "Business, administration and law",
        "Health and welfare",
        "Education",
        "Engineering, manufacturing and construction",
        "Arts and humanities"
      ]
    }
  ],
  "transform": [
    {
      "filter": "indexof(selectedCategories, datum[\"field\"]) >= 0"
    }
  ],
  "usermeta": {
    "explorer": {
      "categoryField": "field",
      "labels": {
        "search": "Search…",
        "noMatches": "No matches.",
        "empty": "Select at least one item to show the chart."
      }
    }
  }
}
