{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын өрхийн сарын дундаж нийт зарлага (төгрөг) 1997-2025 он",
  "data": {
    "url": "/datasets/household-expenditure-total-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "он",
      "type": "quantitative",
      "title": "Он",
      "axis": {"format": "d", "tickMinStep": 5, "grid": false}
    },
    "y": {
      "field": "зарлага_төгрөг",
      "type": "quantitative",
      "title": "Нийт зарлага (төгрөг)",
      "axis": {"format": ",.0f"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"color": "#3b82f6", "strokeWidth": 2.5},
        "color": {
          "x1": 1, "y1": 1, "x2": 1, "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(59, 130, 246, 0.01)"},
            {"offset": 1, "color": "rgba(59, 130, 246, 0.3)"}
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [{"name": "hover", "select": {"type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout"}}],
      "mark": {"type": "point", "filled": true, "color": "#3b82f6", "size": 100},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "он", "type": "quantitative", "title": "Он", "format": "d"},
          {"field": "зарлага_төгрөг", "type": "quantitative", "title": "Нийт зарлага (төгрөг)", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
