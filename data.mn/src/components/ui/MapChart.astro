---
/**
 * MapChart Component
 *
 * Renders choropleth maps with Leaflet (pan/zoom, mobile pinch) from the
 * same Vega-Lite spec files the pipeline validates. The spec is read as
 * config: geojson URL from data.url, values CSV from the lookup transform,
 * join key, color field/type/scheme, stroke, and tooltips.
 *
 * Vega specs stay canonical: validate_vega, thumbnails, and chart-CSV
 * consistency all keep running against the spec file unchanged.
 *
 * Usage (same props as VegaChart):
 * <MapChart spec="/charts/my-map-en.json" title="Map Title" />
 */

export interface Props {
  spec: string;
  title?: string;
  caption?: string;
  aspectRatio?: number; // height/width ratio, default 0.5 (2:1)
}

const { spec, title, caption, aspectRatio = 0.5 } = Astro.props;
const mapId = `map-${Math.random().toString(36).substring(2, 11)}`;
---
<!-- Static Leaflet CSS: part of the swapped page body, so it survives
     Astro ClientRouter navigation (runtime-injected head links don't). -->
<link data-leaflet-css rel="stylesheet" href="/vendor/leaflet/leaflet.css" />

<div class="leaflet-map-container my-4 not-prose">
  {title && <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-gray-100">{title}</h3>}

  <div
    id={mapId}
    class="leaflet-map w-full"
    data-spec={spec}
    data-aspect-ratio={aspectRatio}
    style={`position: relative; z-index: 0; aspect-ratio: ${1 / aspectRatio} / 1; min-height: 320px;`}
  >
    <div class="map-loading text-gray-500 p-4">Loading map…</div>
  </div>

  {caption && <p class="text-sm text-gray-600 dark:text-gray-400 mt-2 italic">{caption}</p>}
</div>

<script is:inline>
  (function() {
    // Prevent multiple initializations
    if (window._leafletMapInitialized) return;
    window._leafletMapInitialized = true;

    let mapViews = {};
    let resizeTimeout = null;

    // Vega-compatible palettes (d3 schemeOranges[9] + category10)
    const ORANGES = ['#fff5eb', '#fee6ce', '#fdd0a2', '#fdae6b', '#fd8d3c', '#f16913', '#d94801', '#a63603', '#7f2704'];
    const CATEGORY10 = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd', '#8c564b', '#e377c2', '#7f7f7f', '#bcbd22', '#17becf'];
    const NULL_COLOR = '#e5e7eb';

    function loadLeaflet() {
      return new Promise(function(resolve, reject) {
        // CSS first: re-ensure the stylesheet even when window.L already
        // exists — Astro swaps drop runtime-injected head elements.
        if (!document.querySelector('link[data-leaflet-css]')) {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.setAttribute('data-leaflet-css', 'true');
          link.href = '/vendor/leaflet/leaflet.css';
          document.head.appendChild(link);
        }
        if (window.L) {
          resolve();
          return;
        }
        if (window._leafletLoading) {
          window._leafletLoading.then(resolve, reject);
          return;
        }
        window._leafletLoading = new Promise(function(res2, rej2) {
          const script = document.createElement('script');
          script.src = '/vendor/leaflet/leaflet.js';
          script.onload = function() { res2(); };
          script.onerror = function() { rej2(new Error('Failed to load Leaflet')); };
          document.head.appendChild(script);
        });
        window._leafletLoading.then(resolve, reject);
      });
    }

    // Minimal RFC4180 parser (quoted commas, escaped quotes, CRLF)
    function parseCSV(text) {
      const rows = [];
      let row = [];
      let field = '';
      let inQuotes = false;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (inQuotes) {
          if (ch === '"') {
            if (text[i + 1] === '"') { field += '"'; i++; }
            else { inQuotes = false; }
          } else {
            field += ch;
          }
        } else if (ch === '"') {
          inQuotes = true;
        } else if (ch === ',') {
          row.push(field);
          field = '';
        } else if (ch === '\n') {
          row.push(field);
          field = '';
          if (!(row.length === 1 && row[0] === '')) rows.push(row);
          row = [];
        } else if (ch !== '\r') {
          field += ch;
        }
      }
      if (field !== '' || row.length > 0) {
        row.push(field);
        rows.push(row);
      }
      const header = rows.shift() || [];
      return rows.map(function(r) {
        const obj = {};
        header.forEach(function(h, idx) { obj[h] = r[idx] !== undefined ? r[idx] : ''; });
        return obj;
      });
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // The small subset of d3 formats our specs use
    function formatValue(value, format) {
      if (value === null || value === undefined || value === '') return '–';
      if (!format) return String(value);
      const num = parseFloat(value);
      if (isNaN(num)) return String(value);
      if (format === ',.1f') {
        return num.toLocaleString('en-US', {minimumFractionDigits: 1, maximumFractionDigits: 1});
      }
      return Math.round(num).toLocaleString('en-US');
    }

    function hexToRgb(hex) {
      return [parseInt(hex.slice(1, 3), 16), parseInt(hex.slice(3, 5), 16), parseInt(hex.slice(5, 7), 16)];
    }

    function oranges(t) {
      t = Math.max(0, Math.min(1, t)) * (ORANGES.length - 1);
      const i = Math.min(Math.floor(t), ORANGES.length - 2);
      const f = t - i;
      const a = hexToRgb(ORANGES[i]);
      const b = hexToRgb(ORANGES[i + 1]);
      const rgb = a.map(function(v, idx) { return Math.round(v + (b[idx] - v) * f); });
      return 'rgb(' + rgb.join(',') + ')';
    }

    // Resolve "properties.x" against feature props, anything else against the joined row
    function resolveField(ref, props, joined) {
      if (ref.indexOf('properties.') === 0) {
        return props[ref.slice('properties.'.length)];
      }
      return joined ? joined[ref] : undefined;
    }

    // Fetch with retries so transient failures (e.g. a server restart
    // mid-load) heal instead of sticking on an error box.
    async function fetchWithRetry(url, label) {
      const attempts = 3;
      let lastError = null;
      for (let i = 0; i < attempts; i++) {
        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error(res.statusText || ('HTTP ' + res.status));
          return res;
        } catch (err) {
          lastError = err;
          if (i + 1 < attempts) await new Promise(function(r) { setTimeout(r, 1500); });
        }
      }
      throw new Error(label + ': ' + (lastError && lastError.message ? lastError.message : lastError));
    }

    async function renderMap(el) {
      const specData = el.dataset.spec;
      const response = await fetchWithRetry(specData, 'Failed to load map spec');
      const mapSpec = await response.json();

      const geoUrl = mapSpec.data.url;
      const transform = (mapSpec.transform || [])[0] || {};
      const lookupRef = transform.lookup;
      const from = transform.from || {};
      const csvUrl = from.data && from.data.url;
      const joinKey = from.key;
      const colorEnc = mapSpec.encoding.color || {};
      const tooltips = mapSpec.encoding.tooltip || [];
      const mark = mapSpec.mark || {};

      const geoRes = await fetchWithRetry(geoUrl, 'Failed to load shapes');
      const geojson = await geoRes.json();

      const joinedByKey = {};
      if (csvUrl && joinKey) {
        const csvRes = await fetchWithRetry(csvUrl, 'Failed to load values');
        parseCSV(await csvRes.text()).forEach(function(row) {
          joinedByKey[String(row[joinKey])] = row;
        });
      }

      const colorField = colorEnc.field;
      const colorType = colorEnc.type || 'nominal';
      const colorValue = colorEnc.value;
      const legendTitle = (colorEnc.legend && colorEnc.legend.title) || '';

      // Build the color scale from joined values
      const values = [];
      geojson.features.forEach(function(feature) {
        if (!colorField) return;
        const joined = lookupRef ? joinedByKey[String(resolveField(lookupRef, feature.properties, null))] : null;
        const v = resolveField(colorField, feature.properties, joined);
        if (v !== null && v !== undefined && v !== '') {
          values.push(colorType === 'quantitative' ? parseFloat(v) : String(v));
        }
      });
      const domainMin = Math.min.apply(null, values);
      const domainMax = Math.max.apply(null, values);
      const domain = Array.from(new Set(values)).sort();
      function colorFor(props, joined) {
        if (colorValue) return colorValue;
        const v = resolveField(colorField, props, joined);
        if (v === null || v === undefined || v === '') return NULL_COLOR;
        if (colorType === 'quantitative') {
          if (domainMax === domainMin) return ORANGES[ORANGES.length - 1];
          return oranges((parseFloat(v) - domainMin) / (domainMax - domainMin));
        }
        const idx = domain.indexOf(String(v));
        return idx === -1 ? NULL_COLOR : CATEGORY10[idx % CATEGORY10.length];
      }

      el.innerHTML = '';
      const map = window.L.map(el, {
      scrollWheelZoom: true,
      zoomSnap: 0.5,
      zoomDelta: 0.5,
    });
      mapViews[el.id] = map;

      function tooltipFor(props, joined) {
        return tooltips.map(function(t) {
          const raw = resolveField(t.field, props, joined);
          return '<div><strong>' + escapeHtml(t.title || t.field) + ':</strong> ' +
            escapeHtml(formatValue(raw, t.format)) + '</div>';
        }).join('');
      }

      const layer = window.L.geoJSON(geojson, {
      style: function(feature) {
        const joined = lookupRef ? joinedByKey[String(resolveField(lookupRef, feature.properties, null))] : null;
        return {
          fillColor: colorFor(feature.properties, joined),
          fillOpacity: 1,
          color: mark.stroke || '#ffffff',
          weight: mark.strokeWidth !== undefined ? mark.strokeWidth : 1,
        };
      },
      onEachFeature: function(feature, shapeLayer) {
        if (!tooltips.length) return;
        const joined = lookupRef ? joinedByKey[String(resolveField(lookupRef, feature.properties, null))] : null;
        shapeLayer.bindTooltip(tooltipFor(feature.properties, joined), {sticky: true});
      },
    }).addTo(map);
      const initialBounds = layer.getBounds();
      map.fitBounds(initialBounds, {padding: [8, 8]});

      // Plain-text attribution: Leaflet's default prefix carries a
      // Ukrainian flag emoji, which we don't want on data.mn.
      map.attributionControl.setPrefix('<a href="https://leafletjs.com">Leaflet</a>');

      // Reset-view button under the zoom controls
      const isMn = document.documentElement.lang === 'mn';
      const resetLabel = isMn ? 'Шинэчлэх' : 'Reset';
      const resetTitle = isMn ? 'Харагдацыг шинэчлэх' : 'Reset view';
      const resetControl = window.L.control({position: 'bottomleft'});
      resetControl.onAdd = function() {
        const container = window.L.DomUtil.create('div', 'leaflet-bar leaflet-control');
        const btn = window.L.DomUtil.create('a', '', container);
        btn.href = '#';
        btn.title = resetTitle;
        btn.setAttribute('role', 'button');
        btn.setAttribute('aria-label', resetTitle);
        btn.textContent = resetLabel;
        btn.style.cssText = 'display: block; padding: 0 10px; width: auto; height: 30px; line-height: 30px; font-size: 12px; color: #111;';
        window.L.DomEvent.on(btn, 'click', function(e) {
          window.L.DomEvent.preventDefault(e);
          window.L.DomEvent.stopPropagation(e);
          map.fitBounds(initialBounds, {padding: [8, 8]});
        });
        window.L.DomEvent.disableClickPropagation(container);
        window.L.DomEvent.disableScrollPropagation(container);
        return container;
      };
      resetControl.addTo(map);

      // Legend (top-right floating card)
      if (!colorValue && values.length) {
        const legend = window.L.control({position: 'topright'});
        legend.onAdd = function() {
          const div = window.L.DomUtil.create('div');
          div.style.cssText = 'background: rgba(255,255,255,0.92); padding: 8px 10px; border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.2); font-size: 12px; line-height: 1.5; max-height: 220px; overflow: auto; color: #111;';
          let html = legendTitle ? '<div style="font-weight: 600; margin-bottom: 4px;">' + escapeHtml(legendTitle) + '</div>' : '';
          if (colorType === 'quantitative') {
            html += '<div style="height: 10px; border-radius: 2px; background: linear-gradient(to right, ' + ORANGES.join(',') + ');"></div>' +
              '<div style="display: flex; justify-content: space-between;"><span>' + escapeHtml(formatValue(domainMin)) + '</span><span>' + escapeHtml(formatValue(domainMax)) + '</span></div>';
          } else {
            html += domain.map(function(v, i) {
              return '<div style="white-space: nowrap;"><span style="display: inline-block; width: 11px; height: 11px; border-radius: 2px; margin-right: 5px; background: ' + CATEGORY10[i % CATEGORY10.length] + ';"></span>' + escapeHtml(v) + '</div>';
            }).join('');
          }
          div.innerHTML = html;
          return div;
        };
        legend.addTo(map);
      }
    }

    function handleResize() {
      if (resizeTimeout) clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function() {
        Object.keys(mapViews).forEach(function(mapId) {
          if (document.getElementById(mapId)) mapViews[mapId].invalidateSize();
        });
      }, 250);
    }

    async function initLeafletMaps() {
      const maps = document.querySelectorAll('.leaflet-map[data-spec]');
      if (maps.length === 0) return;

      try {
        await loadLeaflet();
      } catch (error) {
        console.error('Failed to load Leaflet:', error);
        return;
      }

      maps.forEach(async function(el) {
        if (el.getAttribute('data-rendered') === 'true' || el.dataset.rendering === 'true') return;
        if (el.offsetWidth < 100) {
          setTimeout(initLeafletMaps, 100);
          return;
        }
        el.dataset.rendering = 'true';
        try {
          await renderMap(el);
          el.setAttribute('data-rendered', 'true');
        } catch (error) {
          console.error('Error rendering map:', error);
          const retryLabel = document.documentElement.lang === 'mn' ? 'Дахин оролдох' : 'Retry';
          el.innerHTML = '<div class="text-red-600 p-4">Error loading map: ' + escapeHtml(error.message) +
            ' <button type="button" class="underline" data-retry>' + retryLabel + '</button></div>';
          const retryBtn = el.querySelector('[data-retry]');
          if (retryBtn) {
            retryBtn.addEventListener('click', function() {
              el.removeAttribute('data-rendered');
              initLeafletMaps();
            });
          }
        } finally {
          delete el.dataset.rendering;
        }
      });
    }

    if (!window._leafletResizeListenerAdded) {
      window.addEventListener('resize', handleResize);
      window._leafletResizeListenerAdded = true;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLeafletMaps);
    } else {
      initLeafletMaps();
    }

    document.addEventListener('astro:page-load', function() {
      Object.keys(mapViews).forEach(function(mapId) {
        try { mapViews[mapId].remove(); } catch { /* already gone */ }
      });
      mapViews = {};
      initLeafletMaps();
    });

    window.initLeafletMaps = initLeafletMaps;
  })();
</script>

<style>
  .leaflet-map-container :global(.leaflet-container) {
    background: transparent;
    font: inherit;
    border-radius: 6px;
  }
</style>
