{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia hospital beds by department type in 2024",
  "data": {
    "url": "/datasets/hospital-beds-by-type-en.csv",
    "format": {"type": "csv"}
  },
  "mark": {"type": "bar", "color": "#3b82f6", "cornerRadiusEnd": 4},
  "encoding": {
    "x": {
      "field": "hospital_beds",
      "type": "quantitative",
      "title": "Hospital Beds",
      "axis": {"format": ",d"}
    },
    "y": {
      "field": "department",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {"labelLimit": 220}
    },
    "tooltip": [
      {"field": "department", "title": "Department"},
      {"field": "hospital_beds", "title": "Hospital Beds", "format": ",d"}
    ]
  },
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
