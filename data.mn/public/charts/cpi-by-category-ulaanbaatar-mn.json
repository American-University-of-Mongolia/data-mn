{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Улаанбаатар хотын ХҮИ ангиллаар (2020-2025). 5 үндсэн бүлэгт хуваасан.",
  "data": {
    "url": "/datasets/cpi-by-category-ulaanbaatar-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "сар",
      "type": "temporal",
      "title": "Сар",
      "axis": {"grid": false, "format": "%Y"}
    },
    "y": {
      "field": "утга",
      "type": "quantitative",
      "title": "Сарын өөрчлөлт (%)",
      "axis": {"format": ".1f"}
    },
    "color": {
      "field": "ангилал",
      "type": "nominal",
      "title": "Ангилал",
      "legend": {"orient": "top"},
      "scale": {
        "domain": ["Хүнс, хоол", "Орон сууц, хэрэгсэл", "Тээвэр", "Үйлчилгээ", "Бусад бараа"]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "ангилал", "title": "Ангилал"},
          {"field": "сар", "title": "Сар", "type": "temporal", "format": "%Y-%m"},
          {"field": "утга", "title": "Өөрчлөлт (%)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {"stroke": "transparent"}
  }
}
