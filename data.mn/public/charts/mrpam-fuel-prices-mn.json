{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын аймаг, хотын шатахууны жижиглэнгийн үнийн сарын дундаж, литр тутамд төгрөгөөр.",
  "data": {
    "url": "/datasets/mrpam-fuel-prices-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "сар",
      "type": "temporal",
      "title": "Сар",
      "axis": {
        "format": "%Y-%m",
        "labelAngle": -45,
        "grid": false
      }
    },
    "y": {
      "field": "утга",
      "type": "quantitative",
      "title": "Төгрөг/литр",
      "axis": {
        "format": ",.0f"
      }
    },
    "color": {
      "field": "үзүүлэлт",
      "type": "nominal",
      "title": "Шатахууны төрөл",
      "legend": {
        "orient": "top"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "сар"
            ],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "сар",
            "type": "temporal",
            "title": "Сар",
            "format": "%Y-%m"
          },
          {
            "field": "үзүүлэлт",
            "type": "nominal",
            "title": "Шатахууны төрөл"
          },
          {
            "field": "утга",
            "type": "quantitative",
            "title": "Төгрөг/литр",
            "format": ",.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
