{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын мах үйлдвэрлэлийн түүхэн мэдээ 1940-1992",
  "data": {
    "url": "/datasets/meat-production-historical-total-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "он",
      "type": "quantitative",
      "title": "Он",
      "axis": {"format": "d", "tickMinStep": 5, "grid": false}
    },
    "y": {
      "field": "үйлдвэрлэл_мянган_тонн",
      "type": "quantitative",
      "title": "Мянган тонн",
      "axis": {"format": ".1f"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"color": "#3b82f6", "strokeWidth": 2.5},
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(59, 130, 246, 0.01)"},
            {"offset": 1, "color": "rgba(59, 130, 246, 0.3)"}
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#3b82f6",
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "он", "title": "Он", "format": "d"},
          {"field": "үйлдвэрлэл_мянган_тонн", "title": "Үйлдвэрлэл", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
