{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "\u041c\u043e\u043d\u0433\u043e\u043b \u0423\u043b\u0441\u044b\u043d \u0441\u0430\u0440\u044b\u043d \u0434\u0443\u043d\u0434\u0430\u0436 \u0446\u0430\u043b\u0438\u043d (2001-2025)",
  "data": {
    "url": "/datasets/salary-average-national-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "\u041e\u043d",
      "type": "quantitative",
      "title": "\u041e\u043d",
      "axis": {
        "format": "d",
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "\u0426\u0430\u043b\u0438\u043d (\u041c\u041d\u0422 1000)",
      "type": "quantitative",
      "title": "\u0421\u0430\u0440\u044b\u043d \u0434\u0443\u043d\u0434\u0430\u0436 \u0446\u0430\u043b\u0438\u043d (\u041c\u041d\u0422 '000)",
      "axis": {
        "format": ",.0f",
        "grid": true,
        "gridOpacity": 0.3
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "strokeWidth": 2.5,
          "stroke": "#1f77b4"
        },
        "interpolate": "monotone",
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "gradient": "linear",
          "stops": [
            {
              "offset": 0,
              "color": "rgba(31, 119, 180, 0.02)"
            },
            {
              "offset": 1,
              "color": "rgba(31, 119, 180, 0.35)"
            }
          ]
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "\u041e\u043d",
            "title": "\u041e\u043d",
            "format": "d"
          },
          {
            "field": "\u0426\u0430\u043b\u0438\u043d (\u041c\u041d\u0422 1000)",
            "title": "\u0426\u0430\u043b\u0438\u043d (\u041c\u041d\u0422 '000)",
            "format": ",.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
