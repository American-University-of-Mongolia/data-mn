{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монголын сарын гадаад худалдааны эргэлт, экспорт, импорт, баланс (1997–2026)",
  "data": {
    "url": "/datasets/nso-foreign-trade-monthly-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "сар",
      "type": "temporal",
      "title": "Сар",
      "axis": {"grid": false}
    },
    "y": {
      "field": "value_usd_mn",
      "type": "quantitative",
      "title": "Утга (сая ам.дол)",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "үзүүлэлт",
      "type": "nominal",
      "title": "Үзүүлэлт",
      "scale": {
        "domain": ["Нийт эргэлт", "Экспорт", "Импорт", "Тэнцэл"],
        "range": ["#4c78a8", "#72b7b2", "#e45756", "#f58518"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2, "interpolate": "monotone"}
    },
    {
      "params": [{"name": "hover", "select": {"type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout"}}],
      "mark": {"type": "point", "filled": true, "size": 60},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "сар", "title": "Сар", "type": "temporal", "format": "%Y-%m"},
          {"field": "үзүүлэлт", "title": "Үзүүлэлт"},
          {"field": "value_usd_mn", "title": "Утга (сая ам.дол)", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {"labelFontSize": 14, "titleFontSize": 16, "labelColor": "#64748b", "titleColor": "#334155"},
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
