{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly CPI changes by category group in Ulaanbaatar (2020-2025). Categories grouped into 5 major spending areas.",
  "data": {
    "url": "/datasets/cpi-by-category-ulaanbaatar-en.csv?v=2",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "temporal",
      "title": "Month",
      "axis": {"grid": false, "format": "%Y"}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Monthly Change (%)",
      "axis": {"format": ".1f"}
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "title": "Category",
      "legend": {"orient": "top"},
      "scale": {
        "domain": ["Food & Dining", "Housing & Utilities", "Transport", "Services", "Other Goods"]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "category", "title": "Category"},
          {"field": "month", "title": "Month", "type": "temporal", "format": "%b %Y"},
          {"field": "value", "title": "Change (%)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "view": {"stroke": "transparent"}
  }
}
