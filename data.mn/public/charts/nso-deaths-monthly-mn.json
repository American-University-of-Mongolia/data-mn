{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын 2016 оны 1-р сараас 2026 оны 7-р сар хүртэлх сар бүрийн нас баралтын тоо.",
  "data": {
    "url": "/datasets/nso-deaths-monthly-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "сар",
      "type": "temporal",
      "title": "Сар",
      "axis": {"grid": false}
    },
    "y": {
      "field": "нас_баралт",
      "type": "quantitative",
      "title": "Нас баралт",
      "axis": {"format": ",.0f"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"color": "#d62728", "strokeWidth": 2.5},
        "color": {
          "x1": 1, "y1": 1, "x2": 1, "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(214,39,40,0.02)"},
            {"offset": 1, "color": "rgba(214,39,40,0.25)"}
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [{"name": "hover", "select": {"type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout"}}],
      "mark": {"type": "point", "filled": true, "color": "#d62728", "size": 100},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "сар", "title": "Сар", "type": "temporal", "format": "%Y-%m"},
          {"field": "нас_баралт", "title": "Нас баралт", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
