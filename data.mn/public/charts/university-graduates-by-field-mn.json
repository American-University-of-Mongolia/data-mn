{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын их, дээд сургуулийн төгсөгчид мэргэжлийн чиглэлээр 2019-2024 он",
  "data": {
    "url": "/datasets/university-graduates-by-field-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "он",
      "type": "quantitative",
      "title": "Он",
      "axis": {
        "format": "d",
        "tickMinStep": 1,
        "grid": false
      }
    },
    "y": {
      "field": "төгсөгч",
      "type": "quantitative",
      "title": "Төгсөгчдийн тоо",
      "axis": {
        "format": ",.0f"
      },
      "stack": "zero"
    },
    "color": {
      "field": "чиглэл",
      "type": "nominal",
      "title": "Мэргэжлийн чиглэл",
      "scale": {
        "domain": [
          "Бизнес, удирдахуй, хууль, эрх зүй",
          "Эрүүл мэнд, нийгмийн хамгаалал",
          "Боловсрол",
          "Инженер, үйлдвэрлэл, барилга угсралт",
          "Урлаг, хүмүүнлэг",
          "Нийгмийн шинжлэх ухаан, мэдээлэл, сэтгүүл зүй",
          "Мэдээлэл, харилцаа холбооны технологи",
          "Үйлчилгээ",
          "Байгалийн шинжлэх ухаан, математик, статистик",
          "Хөдөө аж ахуй, ой, загасны аж ахуй, мал эмнэлэг"
        ],
        "range": [
          "#4E79A7",
          "#F28E2B",
          "#E15759",
          "#59A14F",
          "#B07AA1",
          "#76B7B2",
          "#EDC948",
          "#FF9DA7",
          "#9C755F",
          "#BAB0AC"
        ]
      },
      "legend": {
        "orient": "top",
        "values": {
          "expr": "selectedCategories"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "чиглэл",
            "title": "Мэргэжлийн чиглэл"
          },
          {
            "field": "он",
            "title": "Он",
            "format": "d"
          },
          {
            "field": "төгсөгч",
            "title": "Төгсөгч",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  },
  "params": [
    {
      "name": "selectedCategories",
      "value": [
        "Бизнес, удирдахуй, хууль, эрх зүй",
        "Эрүүл мэнд, нийгмийн хамгаалал",
        "Боловсрол",
        "Инженер, үйлдвэрлэл, барилга угсралт",
        "Урлаг, хүмүүнлэг"
      ]
    }
  ],
  "transform": [
    {
      "filter": "indexof(selectedCategories, datum[\"чиглэл\"]) >= 0"
    }
  ],
  "usermeta": {
    "explorer": {
      "categoryField": "чиглэл",
      "labels": {
        "search": "Хайх…",
        "noMatches": "Тохирох зүйл олдсонгүй.",
        "empty": "График харахын тулд дор хаяж нэгийг сонгоно уу."
      }
    }
  }
}
