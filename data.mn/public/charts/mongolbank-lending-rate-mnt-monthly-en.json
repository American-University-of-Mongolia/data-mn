{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia monthly weighted average MNT lending interest rate, Bank of Mongolia.",
  "data": {
    "url": "/datasets/mongolbank-lending-rate-mnt-monthly-en.csv",
    "format": {"type": "csv"}
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2, "interpolate": "monotone", "color": "#ef4444"}
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 60, "color": "#ef4444"},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Month", "format": "%Y-%m"},
          {"field": "lending_rate_pct", "type": "quantitative", "title": "Lending Rate (%)", "format": ".2f"}
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Month",
      "axis": {"format": "%b %Y", "labelAngle": -45, "grid": false}
    },
    "y": {
      "field": "lending_rate_pct",
      "type": "quantitative",
      "title": "Lending Rate (%)",
      "scale": {"zero": false},
      "axis": {"format": ".1f"}
    }
  },
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"}
  }
}
