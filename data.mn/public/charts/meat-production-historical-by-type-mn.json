{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын түүхэн махны үйлдвэрлэл төрлөөр (1940-1992)",
  "data": {
    "url": "/datasets/meat-production-historical-by-type-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "он",
      "type": "quantitative",
      "title": "Он",
      "axis": {
        "format": "d",
        "tickMinStep": 5,
        "grid": false
      }
    },
    "y": {
      "field": "үйлдвэрлэл_мянган_тонн",
      "type": "quantitative",
      "title": "Мянган тонн",
      "axis": {
        "format": ".1f"
      },
      "stack": "zero"
    },
    "color": {
      "field": "төрөл",
      "type": "nominal",
      "title": "Махны төрөл",
      "scale": {
        "domain": ["Үхрийн мах", "Хонь, ямааны мах", "Гахайн мах"],
        "range": ["#3b82f6", "#f59e0b", "#10b981"]
      },
      "legend": {
        "orient": "top",
        "title": null
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.7,
        "line": {
          "strokeWidth": 1.5
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "он",
            "title": "Он",
            "format": "d"
          },
          {
            "field": "төрөл",
            "title": "Махны төрөл"
          },
          {
            "field": "үйлдвэрлэл_мянган_тонн",
            "title": "Үйлдвэрлэл (мянган тонн)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
