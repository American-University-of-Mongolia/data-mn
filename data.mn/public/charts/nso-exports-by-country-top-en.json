{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia exports by top trading partner countries (2005–2025)",
  "data": {
    "url": "/datasets/nso-exports-by-country-top-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {"format": "d", "tickMinStep": 5, "grid": false}
    },
    "y": {
      "field": "exports_usd_mn",
      "type": "quantitative",
      "title": "Exports (USD thousand)",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "title": "Country",
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"}
    },
    {
      "params": [{"name": "hover", "select": {"type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout"}}],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "year", "title": "Year", "format": "d"},
          {"field": "country", "title": "Country"},
          {"field": "exports_usd_mn", "title": "Exports (USD thousand)", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {"labelFontSize": 14, "titleFontSize": 16, "labelColor": "#64748b", "titleColor": "#334155"},
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
