{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсад эмнэлгийн орны тоо төрлөөр (2015–2025)",
  "data": {
    "url": "/datasets/nso-hospital-beds-by-type-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datetime(datum.он, 0, 1)",
      "as": "огноо"
    },
    {
      "filter": "indexof(selectedCategories, datum[\"төрөл\"]) >= 0"
    }
  ],
  "encoding": {
    "x": {
      "field": "огноо",
      "type": "temporal",
      "title": "Он",
      "axis": {
        "format": "%Y",
        "grid": false,
        "labelAngle": -30
      }
    },
    "y": {
      "field": "ор",
      "type": "quantitative",
      "title": "Эмнэлгийн ор",
      "stack": "zero",
      "axis": {
        "format": ","
      }
    },
    "color": {
      "field": "төрөл",
      "type": "nominal",
      "title": "Орны төрөл",
      "scale": {
        "domain": [
          "Дотор",
          "Хүүхэд",
          "Уламжлалт эмчилгээ",
          "Мэс засал",
          "Мэдрэл",
          "Эрчимт эмчилгээ, сэхээн амьдруулах",
          "Эрүү нүүр",
          "Арьс харшил",
          "Эмэгтэйчүүд",
          "Халдварт",
          "Нефролог",
          "Төрөх",
          "Хавдар",
          "Нүд",
          "Бусад",
          "Чих, хамар хоолой",
          "Хөнгөвчлөх эмчилгээ",
          "Сэтгэц",
          "Гэмтэл",
          "Сүрьеэ",
          "Уролог"
        ],
        "range": [
          "#4E79A7",
          "#F28E2B",
          "#E15759",
          "#59A14F",
          "#B07AA1",
          "#76B7B2",
          "#EDC948",
          "#FF9DA7",
          "#9C755F",
          "#BAB0AC",
          "#A0CBE8",
          "#FFBE7D",
          "#FF9D9A",
          "#8CD17D",
          "#D4A6C8",
          "#86BCB6",
          "#F1CE63",
          "#FABFD2",
          "#D7B5A6",
          "#79706E"
        ]
      },
      "legend": {
        "orient": "top",
        "values": {
          "expr": "selectedCategories"
        }
      }
    },
    "order": {
      "field": "төрөл",
      "sort": "ascending"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "он",
            "type": "quantitative",
            "title": "Он",
            "format": "d"
          },
          {
            "field": "төрөл",
            "type": "nominal",
            "title": "Орны төрөл"
          },
          {
            "field": "ор",
            "type": "quantitative",
            "title": "Ор",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelLimit": 300
    },
    "view": {
      "stroke": "transparent"
    }
  },
  "params": [
    {
      "name": "selectedCategories",
      "value": [
        "Дотор",
        "Хүүхэд",
        "Уламжлалт эмчилгээ",
        "Мэс засал",
        "Мэдрэл"
      ]
    }
  ],
  "usermeta": {
    "explorer": {
      "categoryField": "төрөл",
      "labels": {
        "search": "Хайх…",
        "noMatches": "Тохирох зүйл олдсонгүй.",
        "empty": "График харахын тулд дор хаяж нэгийг сонгоно уу."
      }
    }
  }
}
