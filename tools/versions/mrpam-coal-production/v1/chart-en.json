{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly coal production, sales and exports in Mongolia, in thousand tonnes.",
  "data": {
    "url": "/datasets/mrpam-coal-production-en.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
    {
      "fold": ["production_kt", "sales_kt", "export_kt"],
      "as": ["metric", "value"]
    },
    {
      "calculate": "datum.metric === 'production_kt' ? 'Production' : datum.metric === 'sales_kt' ? 'Sales' : 'Exports'",
      "as": "measure"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Month",
      "axis": {"format": "%Y-%m", "labelAngle": -45, "grid": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Thousand tonnes",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "measure",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Production", "Sales", "Exports"],
        "range": ["#4c78a8", "#f58518", "#72b7b2"]
      },
      "legend": {"orient": "top"}
    }
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 2.5}},
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["date"],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Month", "format": "%Y-%m"},
          {
            "field": "measure",
            "type": "nominal",
            "title": "Measure"
          },
          {"field": "value", "type": "quantitative", "title": "Thousand tonnes", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
