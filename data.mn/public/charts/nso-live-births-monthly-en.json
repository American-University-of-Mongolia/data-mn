{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly live births in Mongolia from January 2016 to July 2026.",
  "data": {
    "url": "/datasets/nso-live-births-monthly-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "temporal",
      "title": "Month",
      "axis": {"grid": false}
    },
    "y": {
      "field": "births",
      "type": "quantitative",
      "title": "Live Births",
      "axis": {"format": ",.0f"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"color": "#4c78a8", "strokeWidth": 2.5},
        "color": {
          "x1": 1, "y1": 1, "x2": 1, "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(31,119,180,0.02)"},
            {"offset": 1, "color": "rgba(31,119,180,0.35)"}
          ]
        },
        "interpolate": "monotone"
      }
    },
    {
      "params": [{"name": "hover", "select": {"type": "point", "nearest": true, "on": "pointerover", "clear": "pointerout"}}],
      "mark": {"type": "point", "filled": true, "color": "#4c78a8", "size": 100},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 1}, "value": 0},
        "tooltip": [
          {"field": "month", "title": "Month", "type": "temporal", "format": "%Y-%m"},
          {"field": "births", "title": "Live Births", "type": "quantitative", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
