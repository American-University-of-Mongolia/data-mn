{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол улсын харилцаа холбооны үндсэн үзүүлэлтүүд, 1940–1992 (мянган ширхэгээр).",
  "data": {
    "url": "/datasets/telecommunications-national-mn.csv",
    "format": { "type": "csv" }
  },
  "transform": [
    {
      "filter": {
        "field": "хэмжих_нэгж",
        "oneOf": ["мянган ш"]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "он",
      "type": "quantitative",
      "title": "Он",
      "axis": { "grid": false, "format": "d" }
    },
    "y": {
      "field": "утга",
      "type": "quantitative",
      "title": "Мянган ширхэг",
      "axis": { "format": ",.1f" }
    },
    "color": {
      "field": "үзүүлэлт",
      "type": "nominal",
      "title": "Үзүүлэлт",
      "scale": {
        "domain": ["Телефон цэг", "Радио цэг", "Хүлээн авагч", "Телевизор"],
        "range": ["#3b82f6", "#f59e0b", "#10b981", "#ef4444"]
      },
      "legend": { "orient": "top" }
    }
  },
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 1.5, "interpolate": "monotone", "opacity": 0.85 }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout",
            "fields": ["он"]
          }
        }
      ],
      "mark": { "type": "point", "filled": true, "size": 40 },
      "encoding": {
        "opacity": {
          "condition": { "param": "hover", "empty": false, "value": 1 },
          "value": 0
        },
        "tooltip": [
          { "field": "он", "type": "quantitative", "title": "Он", "format": "d" },
          { "field": "үзүүлэлт", "type": "nominal", "title": "Үзүүлэлт" },
          { "field": "утга", "type": "quantitative", "title": "Мянган ширхэг", "format": ",.1f" }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": { "stroke": "transparent" },
    "legend": { "labelFontSize": 13, "titleFontSize": 14 }
  }
}
