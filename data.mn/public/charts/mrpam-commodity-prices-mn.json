{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Нэг тонн тутамд ам.доллароор илэрхийлсэн таван ашигт малтмалын дэлхийн зах зээлийн сарын үнэ.",
  "data": {
    "url": "/datasets/mrpam-commodity-prices-mn.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "сар",
      "type": "temporal",
      "title": "Огноо",
      "axis": {"format": "%Y-%m", "grid": false, "labelAngle": -30}
    },
    "y": {
      "field": "үнэ",
      "type": "quantitative",
      "title": "Үнэ (ам.доллар/тонн)",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "бараа",
      "type": "nominal",
      "title": "Ашигт малтмал",
      "scale": {
        "domain": ["Зэс (ам.долл/тн)", "Цайр (ам.долл/тн)", "Хар тугалга (ам.долл/тн)", "Цагаан тугалга (ам.долл/тн)", "Молибдени (ам.долл/тн)"],
        "range": ["#4c78a8", "#f58518", "#e45756", "#72b7b2", "#54a24b"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"}},
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 80},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "сар", "type": "temporal", "title": "Огноо", "format": "%Y-%m"},
          {"field": "бараа", "type": "nominal", "title": "Ашигт малтмал"},
          {"field": "үнэ", "type": "quantitative", "title": "Үнэ (ам.доллар/тонн)", "format": ",.1f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {"stroke": "transparent"},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  }
}
