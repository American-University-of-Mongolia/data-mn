{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mongolia monetary policy rate set by the Bank of Mongolia (2016-2025)",
  "data": {
    "url": "/datasets/mongolbank-policy-rate-en.csv",
    "format": {"type": "csv"}
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Date",
      "axis": {"format": "%Y", "labelAngle": 0, "grid": false}
    },
    "y": {
      "field": "policy_rate_pct",
      "type": "quantitative",
      "title": "Policy Rate (%)",
      "scale": {"zero": true},
      "axis": {"format": ".1f"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "step-after",
        "strokeWidth": 2.5,
        "color": "#4c78a8"
      }
    },
    {
      "mark": {
        "type": "area",
        "interpolate": "step-after",
        "color": {
          "x1": 1, "y1": 1, "x2": 1, "y2": 0,
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(76, 120, 168, 0.01)"},
            {"offset": 1, "color": "rgba(76, 120, 168, 0.2)"}
          ]
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "color": "#4c78a8", "size": 100},
      "encoding": {
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Effective Date", "format": "%Y-%m-%d"},
          {"field": "policy_rate_pct", "type": "quantitative", "title": "Policy Rate (%)", "format": ".2f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
