{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Монгол Улсын банкнаас шинээр олгосон зээлийн сар бүрийн урсгал",
  "data": {
    "url": "/datasets/mongolbank-new-issued-loans-mn.csv",
    "format": {
      "type": "csv"
    }
  },
  "encoding": {
    "x": {
      "field": "quarter",
      "type": "temporal",
      "timeUnit": "yearquarter",
      "title": "Улирал",
      "axis": {
        "grid": false,
        "format": "%Y",
        "tickCount": "year",
        "labelAngle": -45
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Улирлын шинэ зээл (тэрбум ₮)",
      "axis": {
        "format": ",.0f",
        "grid": true,
        "gridOpacity": 0.3
      }
    },
    "tooltip": [
      {
        "field": "quarter",
        "type": "temporal",
        "timeUnit": "yearquarter",
        "title": "Улирал",
        "format": "%Y Q%q"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Шинэ зээл (тэрбум төгрөг)",
        "format": ",.1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 16,
      "titlePadding": 10,
      "labelColor": "#64748b",
      "titleColor": "#334155"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  },
  "transform": [
    {
      "timeUnit": "yearquarter",
      "field": "огноо",
      "as": "quarter"
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "rows_in_quarter"
        }
      ],
      "groupby": [
        "quarter"
      ]
    },
    {
      "filter": "datum.rows_in_quarter == 3 || toDate(datum['огноо']) < datetime(2016, 3, 2)"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "шинэ_зээлийн_олголт_тэрбум_төгрөг",
          "as": "value"
        }
      ],
      "groupby": [
        "quarter"
      ]
    }
  ],
  "mark": {
    "type": "bar",
    "color": "#6366f1",
    "opacity": 0.85
  }
}
